# /etc/aob/smtp.env  (systemd EnvironmentFile, partilhado por aob-api e aob-admin)
#
# Fonte unica da SMTP key do Brevo. Ambos os systemd units carregam este
# ficheiro antes do env proprio (api.env / admin.env), portanto a rotacao
# da key faz-se AQUI e num so sitio:
#
#   1) Gerar nova key no painel Brevo (https://app.brevo.com/settings/keys/smtp)
#   2) Editar /etc/aob/smtp.env: linha Smtp__Password=<nova>
#   3) sudo systemctl restart aob-api aob-admin
#
# IMPORTANTE — deliverability (SPF/DKIM/DMARC):
# O `From` (Smtp__From) TEM de ser um endereco de um DOMINIO AUTENTICADO no
# painel Brevo (Senders, Domains -> Authenticate a domain). NUNCA usar aqui
# um endereco @gmail.com — o SPF do gmail.com nao autoriza o Brevo, DMARC
# falha e o email vai para spam ou e rejeitado.
#
# No DNS de aobarcelos.pt (via painel do registrar) precisas de:
#   1) SPF:  v=spf1 include:spf.brevo.com -all
#   2) DKIM: dois CNAME/TXT que o Brevo indica no painel de autenticacao.
#   3) DMARC (recomendado): _dmarc.aobarcelos.pt TXT
#      "v=DMARC1; p=none; rua=mailto:dmarc@aobarcelos.pt"
#      (subir para p=quarantine apos 2-4 semanas de monitorizacao).
#
# Reply-To e definido pelo codigo (email da associacao / contacto), portanto
# as respostas continuam a chegar ao Gmail original sem violar DMARC.
Smtp__Host=smtp-relay.brevo.com
Smtp__Port=587
Smtp__UseSsl=true
Smtp__User=noreply.bva.aob@gmail.com
Smtp__Password=CHANGE_ME_BREVO_SMTP_KEY
Smtp__From=noreply@aobarcelos.pt
Smtp__FromName=Associação Ornitológica de Barcelos

# NAO definir Smtp__DevRedirectTo em producao (em dev redirecciona tudo para 1 email).
