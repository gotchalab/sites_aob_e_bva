# /etc/aob/api.env  (systemd EnvironmentFile)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=aob_prod;Username=aobapp;Password=CHANGE_ME
Uploads__RootPath=/var/www/uploads
Cors__Origins__0=https://aobarcelos.pt
Cors__Origins__1=https://bva-p.aobarcelos.pt
Turnstile__SecretKey=CHANGE_ME_TURNSTILE_SECRET

# --- JWT (obrigatorio em producao — a API recusa arrancar sem esta chave) ---
# Gerar com: openssl rand -base64 48
Jwt__SigningKey=CHANGE_ME_STRONG_KEY_MIN_32_CHARS
Jwt__Issuer=aob
Jwt__Audience=aob-clients
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# --- SMTP (Brevo) ---
# O EmailSender autentica-se com estas credenciais e envia com "From" definido
# dinamicamente por site (site.ContactEmail — equivalente ao mailfrom do Joomla).
# Os senders (aobarcelos@gmail.com, bvap.aob@gmail.com) precisam de estar
# verificados no painel Brevo (Remetentes, domínio, IPs → Senders).
Smtp__Host=smtp-relay.brevo.com
Smtp__Port=587
Smtp__UseSsl=true
Smtp__User=noreply.bva.aob@gmail.com
Smtp__Password=CHANGE_ME_BREVO_SMTP_KEY

# NAO definir Smtp__DevRedirectTo em producao (em dev redirecciona tudo para 1 email).
