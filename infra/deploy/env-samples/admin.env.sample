# /etc/aob/admin.env
ConnectionStrings__Default=Host=localhost;Port=5432;Database=aob_prod;Username=aobapp;Password=CHANGE_ME
Uploads__RootPath=/var/www/uploads

# URL interna da AOB.Api para o admin chamar o endpoint /api/revalidate quando
# o autor guarda um artigo/download/sponsor/site. Sem isto, o cache ISR do
# Next.js so refresca ao fim de revalidate=300s e as alteracoes so aparecem no
# frontend publico com atraso.
Api__BaseUrl=http://127.0.0.1:5000

# --- SMTP (Brevo) ---
# Usado pelo reenvio de emails de convoyage a partir do backoffice
# (FormAdminService quando o admin edita uma inscricao existente).
# Mesmas regras que a API — ver comentarios em api.env.sample.
Smtp__Host=smtp-relay.brevo.com
Smtp__Port=587
Smtp__UseSsl=true
Smtp__User=noreply.bva.aob@gmail.com
Smtp__Password=CHANGE_ME_BREVO_SMTP_KEY
Smtp__From=noreply@aobarcelos.pt
Smtp__FromName=Associação Ornitológica de Barcelos
