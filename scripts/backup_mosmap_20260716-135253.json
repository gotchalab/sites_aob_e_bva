  {
    "id": 157,
    "title": "Convívio de aniversário 2018",
    "content": "<h3><img src=\"/uploads/aob/images/Eventos/conv_2018.jpg\" alt=\"\" width=\"537\" height=\"762\" style=\"display: block; margin-left: auto; margin-right: auto\" loading=\"lazy\"></h3>\n<h3 style=\"text-align: center\">A AOB tem&nbsp;o prazer de anunciar o convívio de aniversario aos seus sócios, amigos e familiares!&nbsp;</h3>\n<h3 style=\"text-align: center\">O convivo irá realizar-se no dia&nbsp;16 de Junho de 2018&nbsp;na&nbsp;Quinta da Peneda (São Martinho de Vila Frescainha)!</h3>\n<h3 style=\"text-align: center\">Os associados interessados devem fazer a inscrição na sede da AOB ou entao pelos seguintes contatos:<span style=\"color: rgba(255, 102, 0, 1)\"> Sr. António Dantas&nbsp;968092651.</span></h3>\n<h3 style=\"text-align: center\"><span style=\"color: rgba(255, 102, 0, 1)\">&nbsp;As inscrições são até ao dia 13 de Junho.</span></h3>\n<h3 style=\"text-align: center\">Venha desfrutar de um dia diferente, cheio de animação e boa disposição!</h3>\n<p style=\"text-align: center\">&nbsp;<strong style=\"color: rgba(51, 102, 255, 1); font-size: 10pt; line-height: 15.808px\">Localização da Quinta da Peneda</strong></p>\n<p style=\"font-size: 12.16px; line-height: 15.808px; text-align: center\">&nbsp;<span style=\"color: rgba(93, 109, 109, 1); font-family: &quot;Open Sans&quot;, sans-serif; font-size: 14.95px; line-height: 22.425px\">{mosmap width='100%'|height='400'|lat='<span style=\"font-size: 12.16px; line-height: 15.808px\">41.542670</span>'|lon='<span style=\"font-size: 12.16px; line-height: 15.808px\">-8.640665</span>'| text='<strong style=\"line-height: 15.808px; color: rgba(51, 102, 255, 1); font-size: 10pt\">Quinta da Peneda</strong>'}</span></p>"
  },
  {
    "id": 164,
    "title": "Convívio de Aniversário da AOB - 2019",
    "content": "<p><img src=\"/uploads/aob/images/convivio_px.png\" alt=\"\" style=\"display: block; margin-left: auto; margin-right: auto\" loading=\"lazy\"></p>\n<h3 style=\"text-align: center\">A AOB tem&nbsp;o prazer de anunciar o convívio de aniversario aos seus sócios, amigos e familiares!&nbsp;</h3>\n<h3 style=\"text-align: center\">O convivo irá realizar-se no dia&nbsp;15 de Junho de 2019&nbsp;na&nbsp;Quinta da Peneda (São Martinho de Vila Frescainha)!</h3>\n<h3 style=\"text-align: center\">Os associados interessados devem fazer a inscrição na sede da AOB ou entao pelos seguintes contatos:<span style=\"color: rgba(255, 102, 0, 1)\">&nbsp;Sr. António Dantas&nbsp;968092651.</span></h3>\n<h3 style=\"text-align: center\"><span style=\"color: rgba(255, 102, 0, 1)\">&nbsp;As inscrições são até ao dia 13 de Junho.</span></h3>\n<h3 style=\"text-align: center\">Venha desfrutar de um dia diferente, cheio de animação e boa disposição!</h3>\n<p style=\"text-align: center\">&nbsp;<strong style=\"color: rgba(51, 102, 255, 1); font-size: 10pt; line-height: 15.808px\">Localização da Quinta da Peneda</strong></p>\n<p style=\"font-size: 12.16px; line-height: 15.808px; text-align: center\">&nbsp;<span style=\"color: rgba(93, 109, 109, 1); font-family: &quot;Open Sans&quot;, sans-serif; font-size: 14.95px; line-height: 22.425px\">{mosmap width='100%'|height='400'|lat='<span style=\"font-size: 12.16px; line-height: 15.808px\">41.542670</span>'|lon='<span style=\"font-size: 12.16px; line-height: 15.808px\">-8.640665</span>'| text='<strong style=\"line-height: 15.808px; color: rgba(51, 102, 255, 1); font-size: 10pt\">Quinta da Peneda</strong>'}</span></p>"
  }
]