<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AOB.Core\AOB.Core.csproj" />
    <ProjectReference Include="..\AOB.Infrastructure\AOB.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.0.884" />
    <PackageReference Include="MailKit" Version="4.13.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="QuestPDF" Version="2026.7.1" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Templates\%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <!-- Fontes embebidas para o gerador Avery 3421 — Liberation Sans é o clone
       open-source (SIL OFL) com métricas idênticas a Arial/Helvetica. Embutir
       evita dependência do sistema (msttcorefonts / DejaVu) que causa
       shrink-to-fit inconsistente entre dev (Windows/Arial) e prod (Linux). -->
  <ItemGroup>
    <EmbeddedResource Include="Convoyage\fonts\LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Convoyage\fonts\LiberationSans-Bold.ttf" />
  </ItemGroup>

</Project>
