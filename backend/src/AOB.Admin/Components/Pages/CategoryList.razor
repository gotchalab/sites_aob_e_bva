@page "/categorias"
@attribute [Authorize]
@inject ContentService Content
@rendermode InteractiveServer

<PageTitle>Categorias · AOB</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Categorias</h1>
    <a class="btn btn-primary" href="/categorias/nova?site=@SelectedSiteId">+ Nova categoria</a>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-3">
        <select class="form-select" @bind="SelectedSiteId" @bind:after="ReloadAsync">
            @foreach (var s in AllSites)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <div class="form-check pt-2">
            <input class="form-check-input" type="checkbox" id="dl" @bind="IncludeDownloads" @bind:after="ReloadAsync" />
            <label class="form-check-label" for="dl">Mostrar categorias de downloads</label>
        </div>
    </div>
</div>

@if (Categories is null)
{
    <p class="text-muted">A carregar...</p>
}
else if (Categories.Count == 0)
{
    <p class="text-muted">Sem categorias.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>Nome</th><th>Slug</th><th>Ordem</th><th class="text-center">Publicada</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var n in Categories)
            {
                var c = n.Category;
                <tr>
                    <td style="padding-left: @(0.75 + n.Depth * 1.5)rem">
                        @if (n.Depth > 0)
                        {
                            <span class="text-muted">└─ </span>
                        }
                        @c.Name
                    </td>
                    <td class="text-muted font-monospace small">@c.Slug</td>
                    <td class="small">@c.SortOrder</td>
                    <td class="text-center">
                        @if (c.IsPublished) { <span class="badge bg-success">sim</span> }
                        else { <span class="badge bg-secondary">nao</span> }
                    </td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/categorias/@c.Id">Editar</a></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Site> AllSites = new();
    private List<ContentService.CategoryNode>? Categories;
    private int SelectedSiteId = 1;
    private bool IncludeDownloads;

    protected override async Task OnInitializedAsync()
    {
        AllSites = Content.Sites().ToList();
        if (AllSites.Count > 0) SelectedSiteId = AllSites[0].Id;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        Categories = await Content.ListCategoryTree(SelectedSiteId, IncludeDownloads);
    }
}
