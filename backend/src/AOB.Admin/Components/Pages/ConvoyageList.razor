@page "/convoyage"
@attribute [Authorize]
@inject ConvoyageAdminService Convoyage
@inject TransportPlanAdminService Plans
@inject ContentService Content
@inject AppDbContext Db
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Convoyage · AOB</PageTitle>

<h1 class="h3 mb-3">Convoyage</h1>

<div class="row g-2 mb-4">
    <div class="col-md-3">
        <select class="form-select" @bind="SelectedSiteId" @bind:after="ReloadAsync">
            @foreach (var s in AllSites)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
    </div>
</div>

@* ── Criar novo ano ── *@
<div class="card mb-4 shadow-sm">
    <div class="card-header fw-semibold">Novo ano de convoyage</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Ano *</label>
                <input type="number" class="form-control" @bind="_newYear" min="2020" max="2100" />
            </div>
            <div class="col-md-5">
                <label class="form-label small text-muted mb-1">Descrição (opcional)</label>
                <input class="form-control" @bind="_newDescription" placeholder="ex: BVA Masters Gent 2026" />
            </div>
            <div class="col-md-auto">
                <button class="btn btn-primary" @onclick="CreateYearAsync"
                        disabled="@(_saving || _newYear < 2020)">
                    Criar
                </button>
            </div>
        </div>
        @if (_createError is not null)
        {
            <div class="alert alert-danger mt-2 mb-0 py-2 small">@_createError</div>
        }
    </div>
</div>

@if (_deleteError is not null)
{
    <div class="alert alert-danger py-2 small">@_deleteError</div>
}

@* ── Lista de anos ── *@
@if (Years is null)
{
    <p class="text-muted">A carregar...</p>
}
else if (Years.Count == 0)
{
    <p class="text-muted">Sem anos de convoyage configurados para este site.</p>
}
else
{
    @foreach (var y in Years)
    {
        <div class="card mb-3 shadow-sm @(y.IsActive ? "border-success" : "")">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fw-bold fs-5">@y.Year</span>
                    @if (y.IsActive)
                    {
                        <span class="badge bg-success">Ativo</span>
                    }
                    <span class="text-muted small">
                        @y.TotalInscricoes inscrição@(y.TotalInscricoes == 1 ? "" : "ões")
                    </span>
                    @if (!string.IsNullOrEmpty(y.Description))
                    {
                        <span class="text-muted small">· @y.Description</span>
                    }
                </div>
                <div class="d-flex gap-2 flex-shrink-0">
                    @if (!y.IsActive)
                    {
                        <button class="btn btn-sm btn-outline-success"
                                @onclick="() => ActivateAsync(y.Id)"
                                disabled="@_saving">
                            Ativar
                        </button>
                    }
                    <a class="btn btn-sm btn-outline-secondary"
                       href="@($"/convoyage/inscricoes/{y.Id}")">
                        Ver inscrições
                    </a>
                    <a class="btn btn-sm btn-outline-primary"
                       href="@($"/convoyage/{y.Id}/transportes")">
                        Transportes
                    </a>
                    @if (!y.IsActive && y.TotalInscricoes == 0)
                    {
                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="() => DeleteYearAsync(y.Id, y.Year)"
                                disabled="@_saving"
                                title="Eliminar ano">
                            Eliminar
                        </button>
                    }
                </div>
            </div>
            <div class="card-body">
                <h6 class="small text-uppercase text-muted fw-semibold mb-2 tracking-wider">
                    Pontos de recolha
                </h6>

                @if (y.CollectionPoints.Count == 0)
                {
                    <p class="text-muted small mb-3">Sem pontos de recolha configurados.</p>
                }
                else
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nome</th>
                                    <th>Local</th>
                                    <th class="text-end" style="width:220px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in y.CollectionPoints)
                                {
                                    var pid = p.Id;
                                    if (_editingPointId == pid)
                                    {
                                        <tr>
                                            <td>
                                                <input class="form-control form-control-sm"
                                                       value="@_editName"
                                                       @oninput="e => _editName = e.Value?.ToString() ?? string.Empty" />
                                            </td>
                                            <td>
                                                <input class="form-control form-control-sm"
                                                       value="@_editLoc"
                                                       @oninput="e => _editLoc = e.Value?.ToString() ?? string.Empty" />
                                            </td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-primary me-1"
                                                        @onclick="() => SavePointEditAsync(pid)"
                                                        disabled="@(_saving || string.IsNullOrWhiteSpace(_editName))">
                                                    Guardar
                                                </button>
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        @onclick="CancelPointEdit">
                                                    Cancelar
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>@p.Name</td>
                                            <td class="text-muted small">@(p.Location ?? "—")</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-secondary"
                                                        @onclick="() => MovePointAsync(p.Id, -1)"
                                                        title="Mover para cima (mais a sul)">↑</button>
                                                <button class="btn btn-sm btn-outline-secondary me-1"
                                                        @onclick="() => MovePointAsync(p.Id, 1)"
                                                        title="Mover para baixo (mais a norte)">↓</button>
                                                <button class="btn btn-sm btn-outline-secondary me-1"
                                                        @onclick="() => StartPointEdit(p)"
                                                        title="Editar">
                                                    Editar
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="() => DeletePointAsync(p.Id, y.Id)"
                                                        title="Eliminar ponto">
                                                    ×
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <input class="form-control form-control-sm"
                               placeholder="Nome do ponto *"
                               value="@GetPointName(y.Id)"
                               @oninput="e => SetPointName(y.Id, e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="col-md-5">
                        <input class="form-control form-control-sm"
                               placeholder="Local (opcional)"
                               value="@GetPointLoc(y.Id)"
                               @oninput="e => SetPointLoc(y.Id, e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="col-md-auto">
                        <button class="btn btn-sm btn-outline-primary"
                                @onclick="() => AddPointAsync(y.Id)"
                                disabled="@(_saving || string.IsNullOrWhiteSpace(GetPointName(y.Id)))">
                            + Adicionar ponto
                        </button>
                    </div>
                </div>

                <hr class="my-4" />

                <h6 class="small text-uppercase text-muted fw-semibold mb-2 tracking-wider">
                    Fecho de inscrições
                </h6>
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small text-muted mb-1">Data e hora limite (opcional)</label>
                        <input type="datetime-local" class="form-control form-control-sm"
                               value="@GetClosesAt(y.Id, y.RegistrationClosesAt)"
                               @oninput="e => SetClosesAt(y.Id, e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="col-md-auto">
                        <button class="btn btn-sm btn-primary"
                                @onclick="() => SaveClosesAtAsync(y.Id)"
                                disabled="@_saving">
                            Guardar
                        </button>
                        @if (y.RegistrationClosesAt.HasValue)
                        {
                            <button class="btn btn-sm btn-outline-secondary ms-1"
                                    @onclick="() => ClearClosesAtAsync(y.Id)"
                                    disabled="@_saving"
                                    title="Remover data de fecho">
                                Limpar
                            </button>
                        }
                    </div>
                    <div class="col-md">
                        @if (y.RegistrationClosesAt.HasValue)
                        {
                            var now = DateTime.UtcNow;
                            var local = LisbonTime.FromUtc(y.RegistrationClosesAt.Value);
                            if (y.RegistrationClosesAt.Value <= now)
                            {
                                <div class="small text-danger">
                                    <b>Encerradas</b> desde @local.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            }
                            else
                            {
                                <div class="small text-success">
                                    Fecham em @FormatCountdown(y.RegistrationClosesAt.Value - now)
                                    · @local.ToString("dd/MM/yyyy HH:mm")
                                </div>
                            }
                        }
                        else
                        {
                            <div class="small text-muted">Sem data limite — inscrições sempre abertas enquanto o ano estiver ativo.</div>
                        }
                    </div>
                </div>
                @if (_closesFeedback.TryGetValue(y.Id, out var cmsg))
                {
                    <div class="small mt-1 @(_closesIsError.Contains(y.Id) ? "text-danger" : "text-success")">@cmsg</div>
                }

                <hr class="my-4" />

                <h6 class="small text-uppercase text-muted fw-semibold mb-2 tracking-wider">
                    Regulamento
                </h6>
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1">ID do download</label>
                        <input type="number" class="form-control form-control-sm" min="1"
                               value="@GetReg(y.Id, y.RegulamentoDownloadId)"
                               @oninput="e => SetReg(y.Id, e.Value?.ToString() ?? string.Empty)"
                               placeholder="ex.: 221" />
                    </div>
                    <div class="col-md-auto">
                        <button class="btn btn-sm btn-primary"
                                @onclick="() => SaveRegAsync(y.Id)"
                                disabled="@_saving">
                            Guardar
                        </button>
                        @if (y.RegulamentoDownloadId.HasValue)
                        {
                            <button class="btn btn-sm btn-outline-secondary ms-1"
                                    @onclick="() => ClearRegAsync(y.Id)"
                                    disabled="@_saving"
                                    title="Remover regulamento">
                                Limpar
                            </button>
                        }
                    </div>
                    <div class="col-md">
                        @if (!string.IsNullOrEmpty(y.RegulamentoTitle))
                        {
                            <div class="small text-success">
                                Ligado a <b>@y.RegulamentoTitle</b> (id @y.RegulamentoDownloadId)
                                — <a href="/downloads/@y.RegulamentoDownloadId" class="link-secondary">editar download</a>
                            </div>
                        }
                        else
                        {
                            <div class="small text-muted">Sem regulamento associado. O checkbox no formulário público aparece sem link.</div>
                        }
                    </div>
                </div>
                @if (_regFeedback.TryGetValue(y.Id, out var rmsg))
                {
                    <div class="small mt-1 @(_regIsError.Contains(y.Id) ? "text-danger" : "text-success")">@rmsg</div>
                }

                <hr class="my-4" />

                <h6 class="small text-uppercase text-muted fw-semibold mb-2 tracking-wider">
                    Declaração TRACES
                </h6>
                <div class="small text-muted mb-2">
                    Preenche estes dois campos para o botão <em>TRACES</em> ficar disponível nas inscrições deste ano.
                </div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small text-muted mb-1">Campeonato de destino</label>
                        <input type="text" class="form-control form-control-sm"
                               maxlength="200"
                               placeholder="ex.: EUROPASHAU26 Karlsruhe"
                               value="@GetCampeonato(y.Id, y.Campeonato)"
                               @oninput="e => SetCampeonato(y.Id, e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted mb-1">Matrícula TRACES</label>
                        <input type="text" class="form-control form-control-sm"
                               maxlength="50"
                               placeholder="ex.: DE082122025"
                               value="@GetMatricula(y.Id, y.MatriculaTraces)"
                               @oninput="e => SetMatricula(y.Id, e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small text-muted mb-1">Data TRACES</label>
                        <input type="date" class="form-control form-control-sm"
                               value="@GetTracesDate(y.Id, y.TracesDate)"
                               @oninput="e => SetTracesDate(y.Id, e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="col-md-auto">
                        <button class="btn btn-sm btn-primary"
                                @onclick="() => SaveTracesAsync(y.Id)"
                                disabled="@_saving">
                            Guardar
                        </button>
                    </div>
                </div>
                @if (_tracesFeedback.TryGetValue(y.Id, out var tmsg))
                {
                    <div class="small mt-1 @(_tracesIsError.Contains(y.Id) ? "text-danger" : "text-success")">@tmsg</div>
                }

                <hr class="my-4" />

                <h6 class="small text-uppercase text-muted fw-semibold mb-3 tracking-wider">
                    Configuração de transportes
                </h6>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Nº total de transportadoras</label>
                        <input type="number" class="form-control form-control-sm" min="1" max="100"
                               value="@GetCfgCargas(y.Id, y.NumCargasAlvo)"
                               @oninput="e => SetCfgCargas(y.Id, e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Aves por transportadora</label>
                        <input type="number" class="form-control form-control-sm" min="1" max="100"
                               value="@GetCfgCap(y.Id, y.CapacidadePorCarga)"
                               @oninput="e => SetCfgCap(y.Id, e.Value?.ToString() ?? string.Empty)" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">Mínimo por transportadora (para merge de zonas)</label>
                        <input type="number" class="form-control form-control-sm" min="0" max="100"
                               value="@GetCfgMin(y.Id, y.MinPorCarga)"
                               @oninput="e => SetCfgMin(y.Id, e.Value?.ToString() ?? string.Empty)" />
                    </div>
                </div>
                <div class="small text-muted mt-1 mb-3">
                    Se a última transportadora de um ponto ficar &lt; mínimo, junta-se ao ponto seguinte na ordem sul→norte.
                    O sistema sugere quantas transportadoras são necessárias por ponto — vais preencher o nome de quem faz cada uma na página de <em>Transportes</em>.
                </div>

                <div class="d-flex align-items-center gap-2 mt-3">
                    <button class="btn btn-sm btn-primary"
                            @onclick="() => SaveCfgAsync(y.Id)"
                            disabled="@_saving">
                        Guardar configuração
                    </button>
                    @if (_cfgFeedback.TryGetValue(y.Id, out var msg))
                    {
                        <span class="small @(_cfgIsError.Contains(y.Id) ? "text-danger" : "text-success")">
                            @msg
                        </span>
                    }
                </div>

                <hr class="my-4" />

                <h6 class="small text-uppercase text-muted fw-semibold mb-3 tracking-wider">
                    Tarifas e taxas
                </h6>
                <div class="small text-muted mb-3">
                    Preços aplicados neste ano — alimentam o formulário público, o PDF e o Excel.
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-2" style="max-width:640px;">
                        <thead>
                            <tr>
                                <th style="width:60%;">Parâmetro</th>
                                <th class="text-end" style="width:120px;">Valor (€)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var pricingRows = new (string Label, Func<string> Get, Action<string> Set)[]
                                {
                                    ("Inscrição (por inscrição)",           () => GetPrice(y.Id, "insc", y.Pricing.PrecoInscricao),           v => SetPrice(y.Id, "insc", v)),
                                    ("Aves BVA (por ave concurso)",         () => GetPrice(y.Id, "ave",  y.Pricing.PrecoAveBva),              v => SetPrice(y.Id, "ave",  v)),
                                    ("Gaiolas (por ave concurso+venda)",    () => GetPrice(y.Id, "gaio", y.Pricing.PrecoGaiola),              v => SetPrice(y.Id, "gaio", v)),
                                    ("Tarifa transporte sócio",             () => GetPrice(y.Id, "trs",  y.Pricing.TarifaTransporteSocio),    v => SetPrice(y.Id, "trs",  v)),
                                    ("Tarifa transporte não sócio",         () => GetPrice(y.Id, "trns", y.Pricing.TarifaTransporteNaoSocio), v => SetPrice(y.Id, "trns", v)),
                                    ("Tarifa adquirente sócio",             () => GetPrice(y.Id, "adqs", y.Pricing.TarifaAdquirenteSocio),    v => SetPrice(y.Id, "adqs", v)),
                                    ("Tarifa adquirente não sócio",         () => GetPrice(y.Id, "adqns",y.Pricing.TarifaAdquirenteNaoSocio), v => SetPrice(y.Id, "adqns",v)),
                                    ("Quota",                               () => GetPrice(y.Id, "quo",  y.Pricing.Quota),                    v => SetPrice(y.Id, "quo",  v)),
                                }; }
                            @foreach (var row in pricingRows)
                            {
                                <tr>
                                    <td class="text-muted">@row.Label</td>
                                    <td class="text-end">
                                        <input type="text" inputmode="decimal"
                                               pattern="[0-9]+([.,][0-9]{1,2})?"
                                               class="form-control form-control-sm text-end"
                                               style="width:110px; display:inline-block;"
                                               value="@row.Get()"
                                               @oninput="e => row.Set(e.Value?.ToString() ?? string.Empty)" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex align-items-center gap-2 mt-2">
                    <button class="btn btn-sm btn-primary"
                            @onclick="() => SavePricingAsync(y.Id)"
                            disabled="@_saving">
                        Guardar tarifas
                    </button>
                    @if (_priceFeedback.TryGetValue(y.Id, out var pmsg))
                    {
                        <span class="small @(_priceIsError.Contains(y.Id) ? "text-danger" : "text-success")">
                            @pmsg
                        </span>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private List<AOB.Core.Entities.Site> AllSites = [];
    private List<ConvoyageAdminService.YearWithPoints>? Years;
    private int SelectedSiteId;

    private int _newYear = DateTime.UtcNow.Year + 1;
    private string? _newDescription;
    private string? _createError;
    private string? _deleteError;
    private bool _saving;

    private Dictionary<int, string> _pointNames = new();
    private Dictionary<int, string> _pointLocs = new();

    private int? _editingPointId;
    private string _editName = "";
    private string _editLoc = "";
    private string? _editError;

    protected override async Task OnInitializedAsync()
    {
        AllSites = Content.Sites().ToList();
        if (AllSites.Count > 0)
        {
            var siteIds = AllSites.Select(s => s.Id).ToList();
            var activeSiteId = await Db.ConvoyageYears
                .AsNoTracking()
                .Where(y => y.IsActive && siteIds.Contains(y.SiteId))
                .Select(y => (int?)y.SiteId)
                .FirstOrDefaultAsync();
            SelectedSiteId = activeSiteId ?? AllSites[0].Id;
        }
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        Years = await Convoyage.ListYearsAsync(SelectedSiteId);
        _pointNames.Clear();
        _pointLocs.Clear();
    }

    private async Task CreateYearAsync()
    {
        _createError = null;
        _saving = true;
        var (_, err) = await Convoyage.CreateYearAsync(SelectedSiteId, _newYear, _newDescription);
        _saving = false;
        if (err is not null) { _createError = err; return; }
        _newDescription = null;
        await ReloadAsync();
    }

    private async Task ActivateAsync(int yearId)
    {
        _saving = true;
        await Convoyage.ActivateYearAsync(SelectedSiteId, yearId);
        _saving = false;
        await ReloadAsync();
    }

    private async Task AddPointAsync(int yearId)
    {
        var name = GetPointName(yearId);
        if (string.IsNullOrWhiteSpace(name)) return;
        _saving = true;
        await Convoyage.AddCollectionPointAsync(yearId, name, GetPointLoc(yearId));
        _saving = false;
        _pointNames.Remove(yearId);
        _pointLocs.Remove(yearId);
        await ReloadAsync();
    }

    private async Task DeleteYearAsync(int yearId, int year)
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Eliminar o ano {year}? Esta ação não pode ser desfeita.");
        if (!ok) return;

        _deleteError = null;
        _saving = true;
        var err = await Convoyage.DeleteYearAsync(yearId);
        _saving = false;
        if (err is not null) { _deleteError = err; return; }
        await ReloadAsync();
    }

    private async Task DeletePointAsync(int pointId, int yearId)
    {
        _saving = true;
        await Convoyage.DeleteCollectionPointAsync(pointId);
        _saving = false;
        await ReloadAsync();
    }

    private void StartPointEdit(ConvoyageCollectionPoint p)
    {
        _editingPointId = p.Id;
        _editName = p.Name;
        _editLoc = p.Location ?? "";
        _editError = null;
    }

    private void CancelPointEdit()
    {
        _editingPointId = null;
        _editName = "";
        _editLoc = "";
        _editError = null;
    }

    private async Task SavePointEditAsync(int pointId)
    {
        _saving = true;
        _editError = await Convoyage.UpdateCollectionPointAsync(pointId, _editName, _editLoc);
        _saving = false;
        if (_editError is not null) { _deleteError = _editError; return; }
        _editingPointId = null;
        _editName = "";
        _editLoc = "";
        await ReloadAsync();
    }

    private string GetPointName(int yearId) =>
        _pointNames.TryGetValue(yearId, out var v) ? v : "";
    private void SetPointName(int yearId, string v) => _pointNames[yearId] = v;
    private string GetPointLoc(int yearId) =>
        _pointLocs.TryGetValue(yearId, out var v) ? v : "";
    private void SetPointLoc(int yearId, string v) => _pointLocs[yearId] = v;

    private async Task MovePointAsync(int pointId, int direction)
    {
        _saving = true;
        await Convoyage.ReorderCollectionPointAsync(pointId, direction);
        _saving = false;
        await ReloadAsync();
    }

    // ── Fecho de inscrições ───────────────────────────────────────────────────
    private readonly Dictionary<int, string> _closesAtEdits = new();
    private readonly Dictionary<int, string> _closesFeedback = new();
    private readonly HashSet<int> _closesIsError = new();

    private string GetClosesAt(int yearId, DateTime? current)
    {
        if (_closesAtEdits.TryGetValue(yearId, out var edited)) return edited;
        return current.HasValue
            ? LisbonTime.FromUtc(current.Value).ToString("yyyy-MM-ddTHH:mm")
            : "";
    }

    private void SetClosesAt(int yearId, string value) => _closesAtEdits[yearId] = value;

    private async Task SaveClosesAtAsync(int yearId)
    {
        _closesFeedback.Remove(yearId);
        _closesIsError.Remove(yearId);

        DateTime? utc = null;
        if (_closesAtEdits.TryGetValue(yearId, out var raw) && !string.IsNullOrWhiteSpace(raw))
        {
            if (!DateTime.TryParse(raw, System.Globalization.CultureInfo.InvariantCulture,
                    System.Globalization.DateTimeStyles.AssumeLocal, out var local))
            {
                _closesFeedback[yearId] = "Data inválida.";
                _closesIsError.Add(yearId);
                return;
            }
            utc = LisbonTime.ToUtc(local);
        }

        _saving = true;
        var err = await Convoyage.UpdateRegistrationClosesAsync(yearId, utc);
        _saving = false;
        if (err is not null)
        {
            _closesFeedback[yearId] = err;
            _closesIsError.Add(yearId);
            return;
        }
        _closesFeedback[yearId] = "Guardado.";
        _closesAtEdits.Remove(yearId);
        await ReloadAsync();
    }

    private async Task ClearClosesAtAsync(int yearId)
    {
        _closesFeedback.Remove(yearId);
        _closesIsError.Remove(yearId);
        _saving = true;
        var err = await Convoyage.UpdateRegistrationClosesAsync(yearId, null);
        _saving = false;
        if (err is not null)
        {
            _closesFeedback[yearId] = err;
            _closesIsError.Add(yearId);
            return;
        }
        _closesFeedback[yearId] = "Data limite removida.";
        _closesAtEdits.Remove(yearId);
        await ReloadAsync();
    }

    // ── Regulamento ───────────────────────────────────────────────────────────
    private readonly Dictionary<int, string> _regEdits = new();
    private readonly Dictionary<int, string> _regFeedback = new();
    private readonly HashSet<int> _regIsError = new();

    private string GetReg(int yearId, int? current)
    {
        if (_regEdits.TryGetValue(yearId, out var edited)) return edited;
        return current?.ToString() ?? "";
    }

    private void SetReg(int yearId, string value) => _regEdits[yearId] = value;

    private async Task SaveRegAsync(int yearId)
    {
        _regFeedback.Remove(yearId);
        _regIsError.Remove(yearId);

        int? id = null;
        if (_regEdits.TryGetValue(yearId, out var raw) && !string.IsNullOrWhiteSpace(raw))
        {
            if (!int.TryParse(raw.Trim(), out var parsed) || parsed <= 0)
            {
                _regFeedback[yearId] = "ID inválido — introduz o número inteiro do download.";
                _regIsError.Add(yearId);
                return;
            }
            id = parsed;
        }

        _saving = true;
        var err = await Convoyage.UpdateRegulamentoAsync(yearId, id);
        _saving = false;
        if (err is not null)
        {
            _regFeedback[yearId] = err;
            _regIsError.Add(yearId);
            return;
        }
        _regFeedback[yearId] = id.HasValue ? "Regulamento associado." : "Regulamento removido.";
        _regEdits.Remove(yearId);
        await ReloadAsync();
    }

    private async Task ClearRegAsync(int yearId)
    {
        _regFeedback.Remove(yearId);
        _regIsError.Remove(yearId);
        _saving = true;
        var err = await Convoyage.UpdateRegulamentoAsync(yearId, null);
        _saving = false;
        if (err is not null)
        {
            _regFeedback[yearId] = err;
            _regIsError.Add(yearId);
            return;
        }
        _regFeedback[yearId] = "Regulamento removido.";
        _regEdits.Remove(yearId);
        await ReloadAsync();
    }

    // ── Declaração TRACES ─────────────────────────────────────────────────────
    private readonly Dictionary<int, string> _tracesCampeonato = new();
    private readonly Dictionary<int, string> _tracesMatricula = new();
    private readonly Dictionary<int, string> _tracesDate = new();
    private readonly Dictionary<int, string> _tracesFeedback = new();
    private readonly HashSet<int> _tracesIsError = new();

    private string GetCampeonato(int yearId, string? current)
        => _tracesCampeonato.TryGetValue(yearId, out var v) ? v : (current ?? "");
    private void SetCampeonato(int yearId, string v) => _tracesCampeonato[yearId] = v;

    private string GetMatricula(int yearId, string? current)
        => _tracesMatricula.TryGetValue(yearId, out var v) ? v : (current ?? "");
    private void SetMatricula(int yearId, string v) => _tracesMatricula[yearId] = v;

    private string GetTracesDate(int yearId, DateOnly? current)
    {
        if (_tracesDate.TryGetValue(yearId, out var v)) return v;
        return current.HasValue ? current.Value.ToString("yyyy-MM-dd") : "";
    }
    private void SetTracesDate(int yearId, string v) => _tracesDate[yearId] = v;

    private async Task SaveTracesAsync(int yearId)
    {
        _tracesFeedback.Remove(yearId);
        _tracesIsError.Remove(yearId);

        var year = Years?.FirstOrDefault(y => y.Id == yearId);
        var camp = GetCampeonato(yearId, year?.Campeonato);
        var mat = GetMatricula(yearId, year?.MatriculaTraces);
        var dateStr = GetTracesDate(yearId, year?.TracesDate);
        DateOnly? date = string.IsNullOrWhiteSpace(dateStr) ? null : DateOnly.Parse(dateStr);

        _saving = true;
        var err = await Convoyage.UpdateTracesFieldsAsync(yearId, camp, mat, date);
        _saving = false;
        if (err is not null)
        {
            _tracesFeedback[yearId] = err;
            _tracesIsError.Add(yearId);
            return;
        }
        _tracesFeedback[yearId] = "Guardado.";
        _tracesCampeonato.Remove(yearId);
        _tracesMatricula.Remove(yearId);
        _tracesDate.Remove(yearId);
        await ReloadAsync();
    }

    private static string FormatCountdown(TimeSpan ts)
    {
        if (ts.TotalSeconds <= 0) return "0h";
        var d = (int)ts.TotalDays;
        var h = ts.Hours;
        var m = ts.Minutes;
        if (d > 0) return $"{d}d {h}h";
        if (h > 0) return $"{h}h {m}min";
        return $"{m}min";
    }

    // ── Configuração de transportes ───────────────────────────────────────────
    private readonly Dictionary<int, string> _cfgCargas = new();
    private readonly Dictionary<int, string> _cfgCap = new();
    private readonly Dictionary<int, string> _cfgMin = new();
    private readonly Dictionary<int, string> _cfgFeedback = new();
    private readonly HashSet<int> _cfgIsError = new();

    private string GetCfgCargas(int y, int def)
        => _cfgCargas.TryGetValue(y, out var v) ? v : def.ToString();
    private void SetCfgCargas(int y, string v) => _cfgCargas[y] = v;

    private string GetCfgCap(int y, int def)
        => _cfgCap.TryGetValue(y, out var v) ? v : def.ToString();
    private void SetCfgCap(int y, string v) => _cfgCap[y] = v;

    private string GetCfgMin(int y, int def)
        => _cfgMin.TryGetValue(y, out var v) ? v : def.ToString();
    private void SetCfgMin(int y, string v) => _cfgMin[y] = v;

    private async Task SaveCfgAsync(int yearId)
    {
        _cfgFeedback.Remove(yearId);
        _cfgIsError.Remove(yearId);

        if (!int.TryParse(GetCfgCargas(yearId, 0), out var nc) ||
            !int.TryParse(GetCfgCap(yearId, 0), out var cap) ||
            !int.TryParse(GetCfgMin(yearId, 0), out var min))
        {
            _cfgFeedback[yearId] = "Valores numéricos inválidos.";
            _cfgIsError.Add(yearId);
            return;
        }

        var cfg = new TransportPlanAdminService.YearConfig(nc, cap, min);

        _saving = true;
        var err = await Plans.UpdateConfigAsync(yearId, cfg);
        _saving = false;

        if (err is not null)
        {
            _cfgFeedback[yearId] = err;
            _cfgIsError.Add(yearId);
        }
        else
        {
            _cfgFeedback[yearId] = "Guardado.";
            _cfgCargas.Remove(yearId);
            _cfgCap.Remove(yearId);
            _cfgMin.Remove(yearId);
            await ReloadAsync();
        }
    }

    // ── Tarifas e taxas ───────────────────────────────────────────────────────
    // Chave composta: "{yearId}:{campo}" para reutilizar um único dicionário.
    private readonly Dictionary<string, string> _prices = new();
    private readonly Dictionary<int, string> _priceFeedback = new();
    private readonly HashSet<int> _priceIsError = new();

    // Formata com vírgula (pt-PT). Se o utilizador estiver a editar em vivo,
    // devolve o que ele digitou (pode ter ponto — o backend aceita ambos).
    private static readonly System.Globalization.CultureInfo _ptPt =
        System.Globalization.CultureInfo.GetCultureInfo("pt-PT");
    private string GetPrice(int y, string key, decimal def)
        => _prices.TryGetValue($"{y}:{key}", out var v)
            ? v
            : def.ToString("0.00", _ptPt);

    private void SetPrice(int y, string key, string v) => _prices[$"{y}:{key}"] = v;

    private async Task SavePricingAsync(int yearId)
    {
        _priceFeedback.Remove(yearId);
        _priceIsError.Remove(yearId);

        static bool TryParseEuro(string s, out decimal v) =>
            decimal.TryParse(s?.Replace(',', '.'),
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture, out v);

        var year = Years?.FirstOrDefault(y => y.Id == yearId);
        if (year is null) { _priceFeedback[yearId] = "Ano não encontrado."; _priceIsError.Add(yearId); return; }

        decimal Read(string key, decimal def)
            => TryParseEuro(GetPrice(yearId, key, def), out var v) ? v : def;

        var p = new ConvoyageAdminService.PricingConfig(
            Read("insc",  year.Pricing.PrecoInscricao),
            Read("ave",   year.Pricing.PrecoAveBva),
            Read("gaio",  year.Pricing.PrecoGaiola),
            Read("trs",   year.Pricing.TarifaTransporteSocio),
            Read("trns",  year.Pricing.TarifaTransporteNaoSocio),
            Read("adqs",  year.Pricing.TarifaAdquirenteSocio),
            Read("adqns", year.Pricing.TarifaAdquirenteNaoSocio),
            Read("quo",   year.Pricing.Quota));

        _saving = true;
        var err = await Convoyage.UpdatePricingAsync(yearId, p);
        _saving = false;

        if (err is not null)
        {
            _priceFeedback[yearId] = err;
            _priceIsError.Add(yearId);
        }
        else
        {
            _priceFeedback[yearId] = "Guardado.";
            foreach (var k in new[] { "insc", "ave", "gaio", "trs", "trns", "adqs", "adqns", "quo" })
                _prices.Remove($"{yearId}:{k}");
            await ReloadAsync();
        }
    }
}
