@page "/formularios/{Id:int}"
@attribute [Authorize]
@using AOB.Application.Contracts
@inject FormAdminService Forms
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

@if (_form is null)
{
    <p class="text-muted">A carregar...</p>
}
else if (_data is null)
{
    <p class="text-danger">Inscrição não encontrada.</p>
}
else
{
    <PageTitle>Inscrição Convoyage #@Id · AOB</PageTitle>

    <div class="d-flex align-items-center gap-2 mb-1">
        <a href="/convoyage/inscricoes" class="btn btn-sm btn-outline-secondary">← Lista</a>
    </div>

    <div class="d-flex justify-content-between align-items-start mb-4 mt-3">
        <div>
            <h1 class="h3 mb-1">
                Inscrição Convoyage #@Id
                <span class="badge @_statusCls ms-2" style="font-size:0.6em;vertical-align:middle;">@_statusLabel</span>
            </h1>
            <div class="text-muted small">
                Recebido em @LisbonTime.FromUtc(_form.SubmittedAt).ToString("dd/MM/yyyy 'às' HH:mm")
                · Convoyage @_data.ConvoyageYear
            </div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/formularios/@Id/edit">Editar</a>
            @if (!string.IsNullOrWhiteSpace(_data.PdfPath))
            {
                <a class="btn btn-outline-primary" href="/formularios/@Id/pdf" target="_blank">Ver PDF</a>
            }
            <button class="btn btn-outline-danger" @onclick="DeleteAsync">Eliminar</button>
        </div>
    </div>

    @* ── 1. Dados do criador ── *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold bg-primary text-white">
            1. Dados do criador
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label text-muted small mb-0">Nome completo</label>
                    <div class="fw-semibold">@_data.NomeCompleto</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small mb-0">País</label>
                    <div>@(_data.Pais ?? "—")</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small mb-0">Email</label>
                    <div><a href="mailto:@_data.Email">@_data.Email</a></div>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small mb-0">Telefone</label>
                    <div>@(_data.Telefone ?? "—")</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small mb-0">Situação BVA</label>
                    <div>@FormatSocioBvaStatus(_data.SocioBvaStatus, _data.SocioBva)</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small mb-0">Nº STAM</label>
                    <div>@(_data.NumeroStam ?? "—")</div>
                </div>
                <div class="col-12">
                    <label class="form-label text-muted small mb-0">Local de recolha</label>
                    <div>@(_data.LocalRecolha ?? "—")</div>
                </div>
            </div>
        </div>
    </div>

    @* ── 2. Aves inscritas a concurso ── *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold bg-primary text-white d-flex justify-content-between align-items-center">
            <span>2. Aves inscritas a concurso</span>
            <span class="badge bg-light text-primary fs-6">@_data.Aves.Count ave@(_data.Aves.Count == 1 ? "" : "s")</span>
        </div>
        <div class="card-body p-0">
            @if (_data.Aves.Count == 0)
            {
                <p class="text-muted p-3 mb-0">Sem aves registadas.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">#</th>
                                <th>Nº Série/Classe</th>
                                <th>Espécie</th>
                                <th>Tipo</th>
                                <th>Mutação</th>
                                <th>Anilha</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int idx = 0;}
                            @foreach (var ave in _data.Aves)
                            {
                                idx++;
                                <tr>
                                    <td class="ps-3 text-muted small">@idx</td>
                                    <td class="fw-semibold font-monospace small">@ave.Serie</td>
                                    <td class="small">@FormatEspecie(ave.Especie)</td>
                                    <td class="small">@FormatTipo(ave.TipoClasse)</td>
                                    <td class="small">@ave.EspecieMutacao</td>
                                    <td class="font-monospace small">@ave.Anilha</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ── 3. Aves para venda ── *@
    @if (_data.AvesVenda.Count > 0)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header fw-semibold bg-primary text-white d-flex justify-content-between align-items-center">
                <span>3. Aves para venda</span>
                <span class="badge bg-light text-primary fs-6">
                    @_data.AvesVenda.Count ave@(_data.AvesVenda.Count == 1 ? "" : "s")
                    · @($"{_data.AvesVenda.Sum(a => a.Preco):0.00}") €
                </span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">#</th>
                                <th>Data Nasc.</th>
                                <th>Sexo</th>
                                <th>Espécie e Mutação</th>
                                <th>Preço</th>
                                <th>Anilha</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int vidx = 0;}
                            @foreach (var ave in _data.AvesVenda)
                            {
                                vidx++;
                                <tr>
                                    <td class="ps-3 text-muted small">@vidx</td>
                                    <td class="small">@(string.IsNullOrWhiteSpace(ave.DataNascimento) ? "—" : ave.DataNascimento)</td>
                                    <td class="small">@FormatSexo(ave.Sexo)</td>
                                    <td class="small">
                                        @ave.EspecieMutacao
                                        @if (ave.EspecieLivre)
                                        {
                                            <span class="badge bg-secondary ms-1" style="font-size:0.7em">livre</span>
                                        }
                                    </td>
                                    <td class="small font-monospace">@($"{ave.Preco:0.00}") €</td>
                                    <td class="font-monospace small">@ave.Anilha</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* ── Aves para transporte (compra/venda) ── *@
    @if (_data.AvesTransporte.Count > 0)
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header fw-semibold bg-primary text-white d-flex justify-content-between align-items-center">
                <span>@TransporteIdx. Aves para transporte (compra/venda)</span>
                <span class="badge bg-light text-primary fs-6">
                    @_data.AvesTransporte.Count ave@(_data.AvesTransporte.Count == 1 ? "" : "s")
                </span>
            </div>
            <div class="card-body p-3">
                <p class="small text-muted mb-2">
                    Aves que o criador compra ou vende — não entram no concurso BVA Masters nem na sala de vendas da BVA.
                </p>
                <div class="alert alert-warning py-2 px-3 small mb-3">
                    <ul class="mb-0 ps-3">
                        <li>
                            <b>Chegada prevista: 12h (hora belga).</b> O destinatário tem obrigatoriamente
                            de estar presente no local a essa hora para receber as aves —
                            <b>não há condições para lhes dar água e alimentação</b> e não nos
                            responsabilizamos por eventuais mortes.
                        </li>
                        <li>
                            <b>Sujeito a validação de espaço:</b> limite total de <b>400 aves para transporte</b>;
                            prioridade para aves de exposição (concurso e sala de vendas BVA).
                            Aves de compra/venda só entram se restar espaço. Confirmação por email
                            <b>após o fecho das inscrições</b>.
                        </li>
                    </ul>
                </div>
                @{
                    var grupos = _data.AvesTransporte
                        .GroupBy(a => (Nome: (a.DestinatarioNome ?? "").Trim(), Wa: (a.DestinatarioWhatsapp ?? "").Trim(), Notas: (a.DestinatarioNotas ?? "").Trim()))
                        .OrderBy(g => g.Key.Nome);
                }
                @foreach (var g in grupos)
                {
                    <div class="border rounded p-2 mb-3">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="fw-semibold">Destinatário:</span>
                            <span>@(string.IsNullOrWhiteSpace(g.Key.Nome) ? "—" : g.Key.Nome)</span>
                            <span class="text-muted">·</span>
                            <span class="text-muted small">WhatsApp:</span>
                            <span class="font-monospace small">@(string.IsNullOrWhiteSpace(g.Key.Wa) ? "—" : g.Key.Wa)</span>
                            <span class="badge bg-secondary ms-auto">@g.Count() ave@(g.Count() == 1 ? "" : "s")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(g.Key.Notas))
                        {
                            <div class="mb-2 small text-muted">
                                <span class="fw-semibold">Notas:</span> @g.Key.Notas
                            </div>
                        }
                        <div class="table-responsive">
                            <table class="table table-sm table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40px">#</th>
                                        <th style="width:120px">Origem</th>
                                        <th>Espécie</th>
                                        <th style="width:220px">Anilha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{int gtidx = 0;}
                                    @foreach (var ave in g)
                                    {
                                        gtidx++;
                                        <tr>
                                            <td class="text-muted small">@gtidx</td>
                                            <td class="small">@FormatOrigem(ave.Origem)</td>
                                            <td class="small">@FormatEspecie(ave.Especie)</td>
                                            <td class="font-monospace small">@ave.Anilha</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @* ── Resumo de custos ── *@
    var cs = ComputeCostSummary();
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold bg-primary text-white d-flex justify-content-between align-items-center">
            <span>@CustosIdx. Resumo de custos</span>
            <span class="badge bg-light text-primary fs-6">@($"{cs.Total:0.00}") €</span>
        </div>
        <div class="card-body p-0">
            <table class="table mb-0">
                <tbody>
                    @if (cs.Fixa > 0m)
                    {
                        <tr>
                            <td>Inscrição na exposição</td>
                            <td class="text-end font-monospace">@($"{cs.Fixa:0.00}") €</td>
                        </tr>
                    }
                    @if (cs.NConcurso > 0)
                    {
                        <tr>
                            <td>Inscrição por ave · @cs.NConcurso × @ConvoyagePricing.InscricaoPorAve.ToString("0.00") €</td>
                            <td class="text-end font-monospace">@($"{cs.Inscricoes:0.00}") €</td>
                        </tr>
                    }
                    @if (cs.TotalAvesBruto > 0)
                    {
                        <tr>
                            <td>Aluguer de gaiola · @cs.TotalAvesBruto × @ConvoyagePricing.GaiolaPorAve.ToString("0.00") €</td>
                            <td class="text-end font-monospace">@($"{cs.GaiolasBruto:0.00}") €</td>
                        </tr>
                        <tr>
                            <td>Transporte @cs.SocioLabel · @cs.TotalAvesBruto × @($"{cs.Tarifa:0.00}") €</td>
                            <td class="text-end font-monospace">@($"{cs.TransporteBruto:0.00}") €</td>
                        </tr>
                    }
                    @if (cs.EspacosTransporte > 0)
                    {
                        <tr>
                            <td>
                                Transporte de aves adquiridas/cedidas @cs.SocioLabel · @cs.EspacosTransporte espaço@(cs.EspacosTransporte == 1 ? "" : "s") × @($"{cs.TarifaAdq:0.00}") €
                                <span class="text-muted small">(max de @cs.NTransporteCompra compra e @cs.NTransporteVende venda)</span>
                            </td>
                            <td class="text-end font-monospace">@($"{cs.TransporteAdquiridasBruto:0.00}") €</td>
                        </tr>
                    }
                    @if (cs.Quota > 0m)
                    {
                        <tr>
                            <td>Quota BVA Portugal</td>
                            <td class="text-end font-monospace">@($"{cs.Quota:0.00}") €</td>
                        </tr>
                    }
                    @if (cs.VendaOferecidas > 0 || cs.EspacosOferecidos > 0)
                    {
                        <tr class="table-success">
                            <td>
                                <i class="bi bi-gift"></i>
                                Oferta (isento de pagamento):
                                @if (cs.VendaOferecidas > 0)
                                {
                                    <span>@cs.VendaOferecidas ave@(cs.VendaOferecidas == 1 ? "" : "s") de venda</span>
                                }
                                @if (cs.VendaOferecidas > 0 && cs.EspacosOferecidos > 0)
                                {
                                    <span> + </span>
                                }
                                @if (cs.EspacosOferecidos > 0)
                                {
                                    <span>@cs.EspacosOferecidos espaço@(cs.EspacosOferecidos == 1 ? "" : "s") de transporte</span>
                                }
                            </td>
                            <td class="text-end font-monospace fw-semibold text-success">−@($"{cs.DescontoOferta:0.00}") €</td>
                        </tr>
                    }
                    <tr class="table-light fw-bold">
                        <td>TOTAL a pagar</td>
                        <td class="text-end font-monospace">@($"{cs.Total:0.00}") €</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @* ── Gestão ── *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold">@GestaoIdx. Gestão</div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-auto">
                    <label class="form-label text-muted small mb-1">Estado atual</label>
                    <div><span class="badge @_statusCls fs-6">@_statusLabel</span></div>
                </div>
                <div class="col-md-4">
                    <label class="form-label text-muted small mb-1">Alterar estado</label>
                    <select class="form-select" @bind="_newStatus">
                        <option value="">— selecionar —</option>
                        <option value="@((int)FormStatus.Handled)">Marcar tratada</option>
                        <option value="@((int)FormStatus.InProgress)">Em curso</option>
                        <option value="@((int)FormStatus.Rejected)">Rejeitar</option>
                        <option value="@((int)FormStatus.Spam)">Spam</option>
                    </select>
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-primary" @onclick="ApplyStatusAsync" disabled="@string.IsNullOrEmpty(_newStatus)">
                        Aplicar
                    </button>
                </div>
            </div>
            @if (_form.Notes is not null)
            {
                <div class="mt-3">
                    <label class="form-label text-muted small mb-1">Notas</label>
                    <p class="mb-0">@_form.Notes</p>
                </div>
            }
            @if (_form.HandledAt.HasValue)
            {
                <div class="mt-3 text-muted small">
                    Processado em @LisbonTime.FromUtc(_form.HandledAt.Value).ToString("dd/MM/yyyy HH:mm")
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] public Task<AuthenticationState>? AuthState { get; set; }

    private FormSubmission? _form;
    private ConvoyageData? _data;
    private string _newStatus = "";
    private string _statusLabel = "";
    private string _statusCls = "";

    private int NumAvesTransporte => _data?.AvesTransporte.Count ?? 0;

    // Snapshot com todos os valores da tabela — mesma fórmula do Edit e do PDF.
    // Aves oferecidas descontam de gaiolas e transporte; espaço adquirido =
    // max(compra, vende). Total já vem líquido do desconto de oferta.
    private record CostSummary(
        int NConcurso, int NVenda, int NTransporteCompra, int NTransporteVende, int EspacosTransporte,
        int VendaOferecidas, int EspacosOferecidos,
        int TotalAvesBruto, string SocioLabel,
        decimal Tarifa, decimal TarifaAdq,
        decimal Fixa, decimal Inscricoes,
        decimal GaiolasBruto, decimal TransporteBruto, decimal TransporteAdquiridasBruto,
        decimal DescontoOferta, decimal Quota, decimal Total);

    private CostSummary ComputeCostSummary()
    {
        var d = _data;
        var nConcurso = d?.Aves.Count ?? 0;
        var nVenda = d?.AvesVenda.Count ?? 0;
        var nTransporte = d?.AvesTransporte.Count ?? 0;
        var nCompra = d?.AvesTransporte.Count(a => a.Origem is "Compra" or "Adquirida") ?? 0;
        var nVendeTr = d?.AvesTransporte.Count(a => a.Origem is "Vende" or "Cedida") ?? 0;
        var espacos = ConvoyagePricing.EspacosTransporteAdquirido(nCompra, nVendeTr);
        var vendaOferecidas = Math.Clamp(d?.NumAvesVendaOferecidas ?? 0, 0, nVenda);
        var espacosOferecidos = Math.Clamp(d?.NumAvesTransporteOferecidas ?? 0, 0, espacos);
        var statusEnum = Enum.TryParse<SocioBvaStatus>(d?.SocioBvaStatus ?? "NaoSocio", out var st)
            ? st
            : ((d?.SocioBva ?? false) ? SocioBvaStatus.JaSocio : SocioBvaStatus.NaoSocio);
        var socioBva = statusEnum != SocioBvaStatus.NaoSocio;
        var tarifa = ConvoyagePricing.TransportePorAve(socioBva);
        var tarifaAdq = ConvoyagePricing.TransporteAdquiridaPorAve(socioBva);
        var custos = ConvoyagePricing.Compute(nConcurso, nVenda, nTransporte, statusEnum,
            vendaOferecidas, espacosOferecidos, nCompra, nVendeTr);
        var totalAvesBruto = nConcurso + nVenda;
        var gaiolasBruto = ConvoyagePricing.GaiolaPorAve * totalAvesBruto;
        var transporteBruto = tarifa * totalAvesBruto;
        var transporteAdqBruto = tarifaAdq * espacos;
        var descontoOferta = (gaiolasBruto - custos.gaiolas)
                             + (transporteBruto - custos.transporte)
                             + (transporteAdqBruto - custos.transporteAdquiridas);
        return new CostSummary(
            NConcurso: nConcurso,
            NVenda: nVenda,
            NTransporteCompra: nCompra,
            NTransporteVende: nVendeTr,
            EspacosTransporte: espacos,
            VendaOferecidas: vendaOferecidas,
            EspacosOferecidos: espacosOferecidos,
            TotalAvesBruto: totalAvesBruto,
            SocioLabel: socioBva ? "(sócio BVA)" : "(não-sócio)",
            Tarifa: tarifa,
            TarifaAdq: tarifaAdq,
            Fixa: custos.fixa,
            Inscricoes: custos.inscricoes,
            GaiolasBruto: gaiolasBruto,
            TransporteBruto: transporteBruto,
            TransporteAdquiridasBruto: transporteAdqBruto,
            DescontoOferta: descontoOferta,
            Quota: custos.quota,
            Total: custos.total);
    }

    private int SectionsBeforeCustos =>
        2 + ((_data?.AvesVenda.Count ?? 0) > 0 ? 1 : 0) + (NumAvesTransporte > 0 ? 1 : 0);
    private string TransporteIdx => ((_data?.AvesVenda.Count ?? 0) > 0 ? 4 : 3).ToString();
    private string CustosIdx => (SectionsBeforeCustos + 1).ToString();
    private string GestaoIdx => (SectionsBeforeCustos + 2).ToString();

    protected override async Task OnInitializedAsync()
    {
        _form = await Forms.GetAsync(Id);
        if (_form is null || _form.FormType != FormType.InscricaoConvoyage)
        {
            _data = null;
            return;
        }

        _data = ParseData(_form.DataJson);
        UpdateStatusBadge();
    }

    private void UpdateStatusBadge()
    {
        if (_form is null) return;
        (_statusLabel, _statusCls) = _form.Status switch
        {
            FormStatus.Pending    => ("Pendente",  "bg-warning text-dark"),
            FormStatus.InProgress => ("Em curso",  "bg-primary"),
            FormStatus.Handled    => ("Tratada",   "bg-success"),
            FormStatus.Rejected   => ("Rejeitada", "bg-secondary"),
            FormStatus.Spam       => ("Spam",      "bg-danger"),
            _                     => (_form.Status.ToString(), "bg-secondary")
        };
    }

    private async Task ApplyStatusAsync()
    {
        if (string.IsNullOrEmpty(_newStatus) || _form is null) return;
        if (!int.TryParse(_newStatus, out var st)) return;

        var user = (await (AuthState ?? Task.FromResult<AuthenticationState>(null!)))?.User;
        var userId = user?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        await Forms.SetStatusAsync(_form.Id, (FormStatus)st, userId, null);
        _form = await Forms.GetAsync(Id);
        _newStatus = "";
        UpdateStatusBadge();
    }

    private async Task DeleteAsync()
    {
        if (_form is null) return;
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Eliminar inscrição #{Id}? Esta ação é irreversível e apaga também o PDF associado.");
        if (!ok) return;

        await Forms.DeleteAsync(_form.Id);
        Nav.NavigateTo("/convoyage/inscricoes");
    }

    private static string FormatEspecie(string? raw) => raw switch
    {
        "agapornis_roseicollis" or "Roseicollis" => "A. roseicollis",
        "agapornis_fischeri"    or "Fischeri"    => "A. fischeri",
        "agapornis_personatus"  or "Personatus"  => "A. personatus",
        "agapornis_nigrigenis"  or "Nigrigenis"  => "A. nigrigenis",
        "agapornis_lilianae"    or "Lilianae"    => "A. lilianae",
        "agapornis_taranta"     or "Taranta"     => "A. taranta",
        "agapornis_canus"       or "Canus"       => "A. canus",
        "agapornis_pullarius"   or "Pullarius"   => "A. pullarius",
        "agapornis_swindernianus" or "Swindernianus" => "A. swindernianus",
        "forpus_coelestis"      or "Coelestis"   => "F. coelestis",
        _ => raw?.Replace('_', ' ') ?? "—"
    };

    private static string FormatTipo(string? raw) => raw switch
    {
        "show"       => "Show",
        "individual" => "Individual",
        _ => raw ?? "—"
    };

    private static string FormatSexo(string? raw) => raw switch
    {
        "Macho"      => "Macho",
        "Femea"      => "Fêmea",
        "Indefinido" => "Indefinido",
        "M"          => "Macho",
        "F"          => "Fêmea",
        _            => raw ?? "—"
    };

    private static ConvoyageData? ParseData(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var r = doc.RootElement;

            string? S(string k) => r.TryGetProperty(k, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String ? v.GetString() : null;
            int I(string k) => r.TryGetProperty(k, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.Number ? v.GetInt32() : 0;
            bool B(string k) => r.TryGetProperty(k, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.True;

            var aves = new List<AveData>();
            if (r.TryGetProperty("Aves", out var avesEl) && avesEl.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                foreach (var a in avesEl.EnumerateArray())
                {
                    string? AS(string k) => a.TryGetProperty(k, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String ? v.GetString() : null;
                    aves.Add(new AveData(AS("Serie"), AS("Especie"), AS("TipoClasse"), AS("EspecieMutacao"), AS("Anilha")));
                }
            }

            var avesVenda = new List<AveVendaData>();
            if (r.TryGetProperty("AvesVenda", out var avEl) && avEl.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                foreach (var a in avEl.EnumerateArray())
                {
                    string? AS(string k) => a.TryGetProperty(k, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String ? v.GetString() : null;
                    bool AB(string k) => a.TryGetProperty(k, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.True;
                    decimal AD(string k) => a.TryGetProperty(k, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.Number ? v.GetDecimal() : 0m;
                    avesVenda.Add(new AveVendaData(
                        AS("Especie"), AS("TipoClasse"), AS("EspecieMutacao"), AB("EspecieLivre"),
                        AS("DataNascimento"), AS("Sexo"), AD("Preco"), AS("Anilha")));
                }
            }

            var avesTransporte = new List<AveTransporteData>();
            if (r.TryGetProperty("AvesTransporte", out var atEl) && atEl.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                foreach (var a in atEl.EnumerateArray())
                {
                    string? AS(string k) => a.TryGetProperty(k, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.String ? v.GetString() : null;
                    bool AB(string k) => a.TryGetProperty(k, out var v) && v.ValueKind == System.Text.Json.JsonValueKind.True;
                    avesTransporte.Add(new AveTransporteData(
                        AS("Especie"),
                        AS("Origem"), AS("Anilha"),
                        AS("DestinatarioNome"), AS("DestinatarioWhatsapp"),
                        AS("DestinatarioNotas")));
                }
            }

            return new ConvoyageData(
                S("NomeCompleto"), S("Email"), S("Telefone"), S("Pais"),
                S("NumeroStam"), S("LocalRecolha"),
                I("ConvoyageYear"), S("PdfPath"), B("SocioBva"), S("SocioBvaStatus"),
                I("NumAvesVendaOferecidas"), I("NumAvesTransporteOferecidas"),
                aves, avesVenda, avesTransporte);
        }
        catch { return null; }
    }

    private static string FormatOrigem(string? raw) => raw switch
    {
        "Compra"    => "Compra",
        "Vende"     => "Vende",
        // legado (dados antigos)
        "Adquirida" => "Compra",
        "Cedida"    => "Vende",
        _            => raw ?? "—"
    };

    private static string FormatSocioBvaStatus(string? status, bool socioBva) => status switch
    {
        "JaSocio"          => "Sócio BVA (quotas pagas)",
        "PagaComInscricao" => "Vai pagar quota BVA com esta inscrição",
        "NaoSocio"         => "Não sócio BVA",
        _                   => socioBva ? "Sócio BVA (quotas pagas)" : "Não sócio BVA",
    };

    private record AveData(string? Serie, string? Especie, string? TipoClasse, string? EspecieMutacao, string? Anilha);

    private record AveVendaData(
        string? Especie, string? TipoClasse, string? EspecieMutacao, bool EspecieLivre,
        string? DataNascimento, string? Sexo, decimal Preco, string? Anilha);

    private record AveTransporteData(
        string? Especie,
        string? Origem, string? Anilha,
        string? DestinatarioNome, string? DestinatarioWhatsapp,
        string? DestinatarioNotas);

    private record ConvoyageData(
        string? NomeCompleto, string? Email, string? Telefone, string? Pais,
        string? NumeroStam, string? LocalRecolha,
        int ConvoyageYear, string? PdfPath, bool SocioBva, string? SocioBvaStatus,
        int NumAvesVendaOferecidas, int NumAvesTransporteOferecidas,
        List<AveData> Aves, List<AveVendaData> AvesVenda, List<AveTransporteData> AvesTransporte);
}
