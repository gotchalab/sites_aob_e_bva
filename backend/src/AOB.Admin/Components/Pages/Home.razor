@page "/"
@attribute [Authorize]
@inject ContentService Content

<PageTitle>Dashboard · AOB</PageTitle>

<h1 class="h3 mb-4">Dashboard</h1>

@if (Sites is null)
{
    <p class="text-muted">A carregar...</p>
}
else
{
    <div class="row g-3">
        @foreach (var (site, stats) in Sites)
        {
            <div class="col-md-6">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h2 class="h5 mb-1">@site.Name</h2>
                                <div class="text-muted small">@site.Domain</div>
                            </div>
                            <span class="badge bg-primary">@site.Slug</span>
                        </div>
                        <hr />
                        <div class="row text-center">
                            <div class="col"><div class="h4 mb-0">@stats.articles</div><div class="small text-muted">artigos</div></div>
                            <div class="col"><div class="h4 mb-0">@stats.downloads</div><div class="small text-muted">downloads</div></div>
                            <div class="col"><div class="h4 mb-0">@stats.categories</div><div class="small text-muted">categorias</div></div>
                            <div class="col"><div class="h4 mb-0">@stats.menuItems</div><div class="small text-muted">menus</div></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<(Site site, (int articles, int downloads, int categories, int menuItems) stats)>? Sites;

    protected override async Task OnInitializedAsync()
    {
        var sites = Content.Sites().ToList();
        var result = new List<(Site, (int, int, int, int))>();
        foreach (var s in sites)
        {
            result.Add((s, await Content.GetStats(s.Id)));
        }
        Sites = result;
    }
}
