    // ── Transports (agrupados por destinatário) ──────────────────────────────

    private void AddTransportGroup()
    {
        _transportGroups.Add(new TransportGroup(
            Origem: "",
            DestinatarioNome: "",
            DestinatarioWhatsapp: "",
            DestinatarioNotas: "",
            Birds: new List<TransportGroupBird> { new("", "") }));
    }

    private void RemoveTransportGroup(int gIdx)
    {
        if (gIdx >= 0 && gIdx < _transportGroups.Count) _transportGroups.RemoveAt(gIdx);
        ClampTransportOffered();
    }

    private void OnTransportOfferedChanged(string? raw, int max)
    {
        _transportOfferedCount = Math.Clamp(ParseIntOr(raw, 0), 0, max);
    }

    private void ClampTransportOffered()
    {
        var maxEspacos = ConvoyagePricing.EspacosTransporteAdquirido(
            _transportGroups.Where(g => g.Origem == "Compra").Sum(g => g.Birds.Count),
            _transportGroups.Where(g => g.Origem == "Vende").Sum(g => g.Birds.Count));
        if (_transportOfferedCount > maxEspacos) _transportOfferedCount = maxEspacos;
        if (_transportOfferedCount < 0) _transportOfferedCount = 0;
    }

    private void UpdateTransportGroup(int gIdx, Func<TransportGroup, TransportGroup> mut)
    {
        if (gIdx < 0 || gIdx >= _transportGroups.Count) return;
        _transportGroups[gIdx] = mut(_transportGroups[gIdx]);
        // Mudar Origem altera o max de espaços; reclampar para não passar do limite.
        ClampTransportOffered();
    }

    private void AddBirdToGroup(int gIdx)
    {
        if (gIdx < 0 || gIdx >= _transportGroups.Count) return;
        _transportGroups[gIdx].Birds.Add(new TransportGroupBird("", ""));
    }

    private void RemoveBirdFromGroup(int gIdx, int bIdx)
    {
        if (gIdx < 0 || gIdx >= _transportGroups.Count) return;
        var birds = _transportGroups[gIdx].Birds;
        if (bIdx >= 0 && bIdx < birds.Count && birds.Count > 1) birds.RemoveAt(bIdx);
        ClampTransportOffered();
    }

    private void UpdateBirdInGroup(int gIdx, int bIdx, Func<TransportGroupBird, TransportGroupBird> mut)
    {
        if (gIdx < 0 || gIdx >= _transportGroups.Count) return;
        var birds = _transportGroups[gIdx].Birds;
        if (bIdx >= 0 && bIdx < birds.Count) birds[bIdx] = mut(birds[bIdx]);
    }

    // ── Helpers ──────────────────────────────────────────────────────────────

    private static decimal ParseDecimal(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return 0m;
        s = s.Replace(',', '.');
        return decimal.TryParse(s, System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0m;
    }

    private static int ParseIntOr(string? s, int def)
    {
        if (string.IsNullOrWhiteSpace(s)) return def;
        return int.TryParse(s, System.Globalization.NumberStyles.Integer,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : def;
    }

    // Snapshot de custos calculado ao vivo para o resumo (mesma fórmula do
    // formulário público e do PDF). Aves de venda oferecidas descontam do total
    // de venda; espaços de transporte oferecidos descontam do nº de espaços.
    // O transporte adquirido é cobrado por espaço = max(compra, vende).
    //
    // Os campos *Bruto contêm o valor sem desconto de oferta (para exibir os
    // preços "cheios" na tabela); DescontoOferta é a soma dos benefícios que
    // aparece como linha negativa. custos.total (Total) já vem descontado.
    private record CostSummary(
        int NConcurso, int NVenda, int NTransporte,
        int NTransporteCompra, int NTransporteVende, int EspacosTransporte,
        int VendaOferecidas, int EspacosOferecidos,
        int VendaFaturavel, int EspacosFaturaveis,
        int TotalAvesBruto, int TotalAvesFaturavel,
        bool SocioBva, string SocioLabel,
        decimal Tarifa, decimal TarifaAdq,
        decimal Fixa, decimal Inscricoes,
        decimal GaiolasBruto, decimal TransporteBruto, decimal TransporteAdquiridasBruto,
        decimal Gaiolas, decimal Transporte, decimal TransporteAdquiridas,
        decimal DescontoOferta, decimal Quota, decimal Total);

    private CostSummary ComputeCostSummary()
    {
        var nConcurso = _individuals.Count + _teams.Count * 4;
        var nVenda = _sales.Count;
        var nTransporte = _transportGroups.Sum(g => g.Birds.Count);
        var nCompra = _transportGroups.Where(g => g.Origem == "Compra").Sum(g => g.Birds.Count);
        var nVendeTr = _transportGroups.Where(g => g.Origem == "Vende").Sum(g => g.Birds.Count);
        var espacos = ConvoyagePricing.EspacosTransporteAdquirido(nCompra, nVendeTr);
        var vendaOferecidas = Math.Clamp(_saleOfferedCount, 0, nVenda);
        var espacosOferecidos = Math.Clamp(_transportOfferedCount, 0, espacos);
        var statusEnum = Enum.TryParse<SocioBvaStatus>(_model?.SocioBvaStatus ?? "NaoSocio", out var st)
            ? st
            : ((_model?.SocioBva ?? false) ? SocioBvaStatus.JaSocio : SocioBvaStatus.NaoSocio);
        var socioBva = statusEnum != SocioBvaStatus.NaoSocio;
        var tarifa = ConvoyagePricing.TransportePorAve(socioBva);
        var tarifaAdq = ConvoyagePricing.TransporteAdquiridaPorAve(socioBva);
        var custos = ConvoyagePricing.Compute(nConcurso, nVenda, nTransporte, statusEnum,
            vendaOferecidas, espacosOferecidos, nCompra, nVendeTr);
        var vendaFaturavel = nVenda - vendaOferecidas;
        var espacosFaturaveis = espacos - espacosOferecidos;
        var totalAvesBruto = nConcurso + nVenda;
        var totalAvesFaturavel = nConcurso + vendaFaturavel;
        var gaiolasBruto = ConvoyagePricing.GaiolaPorAve * totalAvesBruto;
        var transporteBruto = tarifa * totalAvesBruto;
        var transporteAdqBruto = tarifaAdq * espacos;
        // Desconto = (bruto − faturável) para cada componente afectada por oferta.
        var descontoOferta = (gaiolasBruto - custos.gaiolas)
                             + (transporteBruto - custos.transporte)
                             + (transporteAdqBruto - custos.transporteAdquiridas);
        return new CostSummary(
            NConcurso: nConcurso,
            NVenda: nVenda,
            NTransporte: nTransporte,
            NTransporteCompra: nCompra,
            NTransporteVende: nVendeTr,
            EspacosTransporte: espacos,
            VendaOferecidas: vendaOferecidas,
            EspacosOferecidos: espacosOferecidos,
            VendaFaturavel: vendaFaturavel,
            EspacosFaturaveis: espacosFaturaveis,
            TotalAvesBruto: totalAvesBruto,
            TotalAvesFaturavel: totalAvesFaturavel,
            SocioBva: socioBva,
            SocioLabel: socioBva ? "(sócio BVA)" : "(não-sócio)",
            Tarifa: tarifa,
            TarifaAdq: tarifaAdq,
            Fixa: custos.fixa,
            Inscricoes: custos.inscricoes,
            GaiolasBruto: gaiolasBruto,
            TransporteBruto: transporteBruto,
            TransporteAdquiridasBruto: transporteAdqBruto,
            Gaiolas: custos.gaiolas,
            Transporte: custos.transporte,
            TransporteAdquiridas: custos.transporteAdquiridas,
            DescontoOferta: descontoOferta,
            Quota: custos.quota,
            Total: custos.total);
    }

