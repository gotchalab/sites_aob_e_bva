@page "/formularios/{Id:int}/edit"
@attribute [Authorize]
@using AOB.Application.Contracts
@inject FormAdminService Forms
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Editar inscrição #@Id · AOB</PageTitle>

@if (_loading)
{
    <p class="text-muted">A carregar...</p>
}
else if (_model is null)
{
    <div class="alert alert-danger">Inscrição não encontrada ou não é do tipo convoyage.</div>
    <a class="btn btn-outline-secondary" href="/convoyage/inscricoes">← Lista</a>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-1">
        <a href="@($"/formularios/{Id}")" class="btn btn-sm btn-outline-secondary">← Detalhes</a>
    </div>

    <div class="d-flex justify-content-between align-items-start mb-4 mt-3">
        <h1 class="h3 mb-0">Editar inscrição convoyage #@Id</h1>
    </div>

    @if (_fieldErrors.Count > 0)
    {
        <div class="alert alert-danger">
            <b>Existem @_fieldErrors.Count campo@(_fieldErrors.Count == 1 ? "" : "s") por corrigir.</b>
            Verifique os campos assinalados a vermelho abaixo.
        </div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (_saved)
    {
        <div class="alert alert-success">Alterações guardadas.</div>
    }

    @* ── Dados do criador ── *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold bg-primary text-white">1. Dados do criador</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small text-muted mb-1">Nome completo *</label>
                    <input id="fld-nomeCompleto" class="form-control @Inv("nomeCompleto")" value="@_model.NomeCompleto"
                           @oninput="e => Update(m => m with { NomeCompleto = StrOf(e) })" />
                    @FldMsg("nomeCompleto")
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted mb-1">País *</label>
                    <input id="fld-pais" class="form-control @Inv("pais")" value="@_model.Pais"
                           @oninput="e => Update(m => m with { Pais = StrOf(e) })" />
                    @FldMsg("pais")
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted mb-1">Email *</label>
                    <input id="fld-email" class="form-control @Inv("email")" type="email" value="@_model.Email"
                           @oninput="e => Update(m => m with { Email = StrOf(e) })" />
                    @FldMsg("email")
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted mb-1">Telefone</label>
                    <input class="form-control" value="@_model.Telefone"
                           @oninput="e => Update(m => m with { Telefone = StrOrNull(e) })" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted mb-1">Situação BVA</label>
                    <select class="form-select" value="@_model.SocioBvaStatus"
                            @onchange="OnSocioStatusChanged">
                        <option value="JaSocio">Sócio BVA (quotas pagas)</option>
                        <option value="PagaComInscricao">Vai pagar quota BVA com a inscrição</option>
                        <option value="NaoSocio">Não sócio BVA</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-muted mb-1">Nº Criador Nacional (STAM) *</label>
                    <input id="fld-numeroStam" class="form-control @Inv("numeroStam")" value="@_model.NumeroStam"
                           placeholder="ex.: PT302O"
                           @oninput="e => Update(m => m with { NumeroStam = StrOrNull(e) })" />
                    @FldMsg("numeroStam")
                </div>
                <div class="col-md-12">
                    <label class="form-label small text-muted mb-1">Morada (para Declaração TRACES)</label>
                    <input class="form-control" value="@_model.Morada"
                           placeholder="Rua e número"
                           @oninput="e => Update(m => m with { Morada = StrOrNull(e) })" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Código Postal</label>
                    <input class="form-control" value="@_model.CodigoPostal"
                           placeholder="0000-000" pattern="\d{4}-\d{3}"
                           @oninput="e => Update(m => m with { CodigoPostal = StrOrNull(e) })" />
                </div>
                <div class="col-md-8">
                    <label class="form-label small text-muted mb-1">Localidade</label>
                    <input class="form-control" value="@_model.Localidade"
                           @oninput="e => Update(m => m with { Localidade = StrOrNull(e) })" />
                </div>
                <div class="col-12">
                    <label class="form-label small text-muted mb-1">Assinatura</label>
                    @if (!_signatureEditing)
                    {
                        @if (!string.IsNullOrWhiteSpace(_model.AssinaturaPath))
                        {
                            <div class="border rounded p-2 bg-light d-inline-block">
                                <img src="@($"/formularios/{Id}/assinatura?v={_assinaturaCacheBust}")"
                                     alt="Assinatura do criador"
                                     style="max-width:360px; max-height:120px; display:block;" />
                            </div>
                        }
                        else
                        {
                            <div class="small text-muted">Sem assinatura registada.</div>
                        }
                        <div class="mt-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    @onclick="StartSignatureEdit">
                                <i class="bi bi-pencil"></i>
                                @(string.IsNullOrWhiteSpace(_model.AssinaturaPath) ? "Adicionar assinatura" : "Editar assinatura")
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="border rounded bg-white shadow-sm" style="max-width:520px;">
                            <canvas id="admin-signature-canvas"
                                    style="width:100%; height:180px; display:block; touch-action:none; cursor:crosshair;"></canvas>
                        </div>
                        <div class="mt-2 d-flex flex-wrap gap-2 align-items-center">
                            <button type="button" class="btn btn-sm btn-primary" @onclick="SaveSignatureAsync"
                                    disabled="@_savingSignature">
                                Guardar assinatura
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-info" @onclick="GenerateSignatureAsync"
                                    title="Preenche o canvas com uma assinatura estilizada com o nome do criador. Clica de novo para variar.">
                                <i class="bi bi-magic"></i> Gerar com o nome
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSignatureCanvas">
                                Limpar
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelSignatureEdit">
                                Cancelar
                            </button>
                            @if (_signatureFeedback is not null)
                            {
                                <span class="small @(_signatureFeedbackError ? "text-danger" : "text-success")">@_signatureFeedback</span>
                            }
                        </div>
                        <div class="small text-muted mt-1">
                            Desenhe a assinatura no espaço acima. Ao guardar, esta substitui a anterior
                            e passa a aparecer na Declaração TRACES.
                        </div>
                    }
                </div>
                <div class="col-12">
                    <label class="form-label small text-muted mb-1">Local de recolha</label>
                    @if (_collectionPoints.Count > 0)
                    {
                        <select class="form-select" value="@_model.LocalRecolha"
                                @onchange="e => Update(m => m with { LocalRecolha = StrOf(e) })">
                            @if (!_collectionPoints.Any(p => FormatPoint(p) == _model.LocalRecolha)
                                 && !string.IsNullOrWhiteSpace(_model.LocalRecolha))
                            {
                                <option value="@_model.LocalRecolha">@_model.LocalRecolha (actual)</option>
                            }
                            @foreach (var p in _collectionPoints)
                            {
                                <option value="@FormatPoint(p)">@FormatPoint(p)</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input class="form-control" value="@_model.LocalRecolha"
                               @oninput="e => Update(m => m with { LocalRecolha = StrOf(e) })" />
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Aves individuais ── *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold bg-primary text-white d-flex justify-content-between align-items-center">
            <span>2. Aves individuais</span>
            <button class="btn btn-sm btn-light" @onclick="AddIndividual">+ Adicionar ave</button>
        </div>
        <div class="card-body p-0">
            @if (_individuals.Count == 0)
            {
                <p class="text-muted p-3 mb-0">Sem aves individuais.</p>
            }
            else
            {
                <div class="table-responsive" style="overflow:visible;">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width:40px">#</th>
                                <th style="width:180px">Espécie *</th>
                                <th>Nº Série/Classe — Espécie e Mutação *</th>
                                <th style="width:260px">Anilha *</th>
                                <th style="width:50px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < _individuals.Count; i++)
                            {
                                var idx = i;
                                var b = _individuals[idx];
                                var kSp = $"ind_{idx}_species";
                                var kSel = $"ind_{idx}_selection";
                                var kAn = $"ind_{idx}_anilha";
                                <tr>
                                    <td class="text-muted">@(idx + 1)</td>
                                    <td>
                                        <select id="fld-@kSp" class="form-select form-select-sm @Inv(kSp)" value="@b.Species"
                                                @onchange="e => OnIndividualSpeciesChange(idx, StrOf(e))">
                                            <option value="">—</option>
                                            @foreach (var sp in SpeciesOptions)
                                            {
                                                <option value="@sp.Key">@sp.Label</option>
                                            }
                                        </select>
                                        @FldMsg(kSp)
                                    </td>
                                    <td>
                                        <div id="fld-@kSel">
                                            <NomenclatureCombobox
                                                Groups="ComboGroups(MutationsForConcurso(b.Species))"
                                                Value="@DisplayFor(b.Serie, b.Mutation)"
                                                Placeholder="ex: 400/03 — A. fischeri  ou  grupo de estudo"
                                                Disabled="@string.IsNullOrEmpty(b.Species)"
                                                Invalid="@HasErr(kSel)"
                                                OnItemSelected="sel => OnIndividualItemSelected(idx, sel)" />
                                        </div>
                                        @FldMsg(kSel)
                                    </td>
                                    <td>
                                        <input id="fld-@kAn" class="form-control form-control-sm font-monospace @Inv(kAn)" value="@b.Anilha"
                                               placeholder="AOB PT STAM 001 FNP26 5.0"
                                               @oninput="e => UpdateIndividual(idx, x => x with { Anilha = StrOf(e) })" />
                                        @FldMsg(kAn)
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => RemoveIndividual(idx)" title="Remover">×</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ── Equipas ── *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold bg-primary text-white d-flex justify-content-between align-items-center">
            <span>3. Equipas (4 aves · A → D)</span>
            <button class="btn btn-sm btn-light" @onclick="AddTeam">+ Adicionar equipa</button>
        </div>
        <div class="card-body">
            @if (_teams.Count == 0)
            {
                <p class="text-muted mb-0">Sem equipas.</p>
            }
            else
            {
                @for (int i = 0; i < _teams.Count; i++)
                {
                    var tIdx = i;
                    var t = _teams[tIdx];
                    var kSp = $"team_{tIdx}_species";
                    var kSel = $"team_{tIdx}_selection";
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="fw-semibold">Equipa @(tIdx + 1)</span>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => RemoveTeam(tIdx)">Remover equipa</button>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">Espécie *</label>
                                <select id="fld-@kSp" class="form-select form-select-sm @Inv(kSp)" value="@t.Species"
                                        @onchange="e => OnTeamSpeciesChange(tIdx, StrOf(e))">
                                    <option value="">—</option>
                                    @foreach (var sp in SpeciesOptions)
                                    {
                                        <option value="@sp.Key">@sp.Label</option>
                                    }
                                </select>
                                @FldMsg(kSp)
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small text-muted mb-1">Nº Série/Classe — Espécie e Mutação *</label>
                                <div id="fld-@kSel">
                                    <NomenclatureCombobox
                                        Groups="ComboGroups(MutationsForTeam(t.Species))"
                                        Value="@DisplayFor(t.Serie, t.Mutation)"
                                        Placeholder="ex: 451/01 — A. roseicollis greenseries"
                                        Disabled="@string.IsNullOrEmpty(t.Species)"
                                        Invalid="@HasErr(kSel)"
                                        OnItemSelected="sel => OnTeamItemSelected(tIdx, sel)" />
                                </div>
                                @FldMsg(kSel)
                            </div>
                        </div>
                        <label class="form-label small text-muted mb-1">Anilhas · A (topo) → D (fundo) *</label>
                        @for (int j = 0; j < 4; j++)
                        {
                            var pos = TeamPositions[j];
                            var jIdx = j;
                            var canUp = jIdx > 0;
                            var canDown = jIdx < 3;
                            var kAn = $"team_{tIdx}_anilha{jIdx}";
                            <div class="mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-secondary" style="width:28px">@pos</span>
                                    <input id="fld-@kAn" class="form-control form-control-sm font-monospace @Inv(kAn)"
                                           value="@t.Anilhas[jIdx]"
                                           placeholder="AOB PT STAM 001 FNP26 5.0"
                                           @oninput="e => UpdateTeamAnilha(tIdx, jIdx, StrOf(e))" />
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => MoveTeamMember(tIdx, jIdx, -1)"
                                            disabled="@(!canUp)" title="Subir">↑</button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => MoveTeamMember(tIdx, jIdx, +1)"
                                            disabled="@(!canDown)" title="Descer">↓</button>
                                </div>
                                @FldMsg(kAn)
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    @* ── Aves para venda ── *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold bg-primary text-white d-flex justify-content-between align-items-center">
            <span>4. Aves para venda</span>
            <button class="btn btn-sm btn-light" @onclick="AddSale">+ Adicionar ave venda</button>
        </div>
        <div class="card-body">
            @if (_sales.Count > 0)
            {
                <div class="alert alert-success py-2 px-3 small mb-3 d-flex align-items-center flex-wrap gap-2">
                    <i class="bi bi-gift"></i>
                    <b>Aves oferecidas (isentas de pagamento):</b>
                    <input type="number" min="0" max="@_sales.Count" step="1"
                           class="form-control form-control-sm"
                           style="width:80px"
                           value="@_saleOfferedCount"
                           @onchange="e => OnSaleOfferedChanged(StrOf(e))" />
                    <span class="text-muted">de @_sales.Count · não contam para o cálculo de gaiolas e transporte.</span>
                </div>
            }
            @if (_sales.Count == 0)
            {
                <p class="text-muted mb-0">Sem aves para venda.</p>
            }
            else
            {
                @for (int i = 0; i < _sales.Count; i++)
                {
                    var idx = i;
                    var s = _sales[idx];
                    var kSp = $"sale_{idx}_species";
                    var kSel = $"sale_{idx}_selection";
                    var kPr = $"sale_{idx}_preco";
                    var kAn = $"sale_{idx}_anilha";
                    <div class="border rounded p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="fw-semibold">Ave venda @(idx + 1)</span>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveSale(idx)">Remover</button>
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">Espécie *</label>
                                <select id="fld-@kSp" class="form-select form-select-sm @Inv(kSp)" value="@s.Species"
                                        @onchange="e => OnSaleSpeciesChange(idx, StrOf(e))">
                                    <option value="">—</option>
                                    @foreach (var sp in SpeciesOptions)
                                    {
                                        <option value="@sp.Key">@sp.Label</option>
                                    }
                                </select>
                                @FldMsg(kSp)
                            </div>
                            <div class="col-md-8">
                                <label class="form-label small text-muted mb-1">Nº Série/Classe — Espécie e Mutação *</label>
                                <div class="form-check form-check-inline small mb-1">
                                    <input class="form-check-input" type="checkbox" id="fs_@idx"
                                           checked="@s.FreeSpecies"
                                           @onchange="e => OnSaleFreeSpeciesToggle(idx, (bool)(e.Value ?? false))" />
                                    <label class="form-check-label small" for="fs_@idx">
                                        Mutação fora do catálogo BVA (texto livre)
                                    </label>
                                </div>
                                <div id="fld-@kSel">
                                    @if (s.FreeSpecies)
                                    {
                                        <input class="form-control form-control-sm @Inv(kSel)"
                                               value="@s.Mutation"
                                               placeholder="ex: orange face green"
                                               @oninput="e => UpdateSale(idx, x => x with { Mutation = StrOf(e), Serie = string.Empty })" />
                                    }
                                    else
                                    {
                                        <NomenclatureCombobox
                                            Groups="ComboGroups(MutationsForSale(s.Species))"
                                            Value="@DisplayFor(s.Serie, s.Mutation)"
                                            Placeholder="ex: 002/02 — orange face green"
                                            Disabled="@string.IsNullOrEmpty(s.Species)"
                                            Invalid="@HasErr(kSel)"
                                            OnItemSelected="sel => OnSaleItemSelected(idx, sel)" />
                                    }
                                </div>
                                @FldMsg(kSel)
                            </div>
                        </div>
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label small text-muted mb-1">Data nasc.</label>
                                <input class="form-control form-control-sm" value="@s.DataNascimento"
                                       placeholder="yyyy-mm-dd"
                                       @oninput="e => UpdateSale(idx, x => x with { DataNascimento = StrOf(e) })" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-muted mb-1">Sexo</label>
                                <select class="form-select form-select-sm" value="@s.Sexo"
                                        @onchange="e => UpdateSale(idx, x => x with { Sexo = StrOf(e) })">
                                    <option value="Macho">Macho</option>
                                    <option value="Femea">Fêmea</option>
                                    <option value="Indefinido">Indefinido</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small text-muted mb-1">Preço €</label>
                                <input id="fld-@kPr" class="form-control form-control-sm font-monospace @Inv(kPr)" type="number" step="0.01" min="0"
                                       value="@s.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       @onchange="e => UpdateSale(idx, x => x with { Preco = ParseDecimal(StrOf(e)) })" />
                                @FldMsg(kPr)
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small text-muted mb-1">Anilha *</label>
                                <input id="fld-@kAn" class="form-control form-control-sm font-monospace @Inv(kAn)" value="@s.Anilha"
                                       @oninput="e => UpdateSale(idx, x => x with { Anilha = StrOf(e) })" />
                                @FldMsg(kAn)
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    @* ── Aves para transporte (compra/venda) ── *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold bg-primary text-white d-flex justify-content-between align-items-center">
            <span>5. Aves para transporte (compra/venda)</span>
            <button class="btn btn-sm btn-light" @onclick="AddTransportGroup">+ Adicionar destinatário</button>
        </div>
        <div class="card-body">
            <p class="small text-muted mb-2">
                Aves que o criador compra ou vende — não entram no concurso BVA Masters nem na sala de vendas da BVA.
            </p>
            <div class="alert alert-warning py-2 px-3 small mb-3">
                <ul class="mb-0 ps-3">
                    <li>
                        <b>Chegada prevista: 12h (hora belga).</b> O destinatário tem obrigatoriamente
                        de estar presente no local a essa hora para receber as aves —
                        <b>não há condições para lhes dar água e alimentação</b> e não nos
                        responsabilizamos por eventuais mortes.
                    </li>
                    <li>
                        <b>Se comprou aves na Bélgica:</b> o remetente indicado tem de entregar as aves
                        à <b>convoyage portuguesa no domingo de manhã</b>, e não antes. Entregas antecipadas
                        não podem ser aceites — <b>não temos condições para dar água e alimentação às aves</b>
                        e não nos responsabilizamos por eventuais mortes.
                    </li>
                    <li>
                        <b>Sujeito a validação de espaço:</b> limite total de <b>400 aves para transporte</b>;
                        prioridade para aves de exposição (concurso e sala de vendas BVA).
                        Aves de compra/venda só entram se restar espaço. Confirmação por email
                        <b>após o fecho das inscrições</b>.
                    </li>
                </ul>
            </div>
            @{
                var totalTransportBirds = _transportGroups.Sum(g => g.Birds.Count);
                var nCompraTr = _transportGroups.Where(g => g.Origem == "Compra").Sum(g => g.Birds.Count);
                var nVendeTr = _transportGroups.Where(g => g.Origem == "Vende").Sum(g => g.Birds.Count);
                var espacosTr = ConvoyagePricing.EspacosTransporteAdquirido(nCompraTr, nVendeTr);
            }
            @if (espacosTr > 0)
            {
                <div class="alert alert-info py-2 px-3 small mb-2">
                    <b>Cálculo por espaço:</b> cada espaço na transportadora pode ir (PT→BE), voltar (BE→PT) ou ambos.
                    Custo = <b>max(compra, vende) = max(@nCompraTr, @nVendeTr) = @espacosTr espaço@(espacosTr == 1 ? "" : "s")</b>.
                </div>
                <div class="alert alert-success py-2 px-3 small mb-3 d-flex align-items-center flex-wrap gap-2">
                    <i class="bi bi-gift"></i>
                    <b>Espaços oferecidos (isentos de pagamento):</b>
                    <input type="number" min="0" max="@espacosTr" step="1"
                           class="form-control form-control-sm"
                           style="width:80px"
                           value="@_transportOfferedCount"
                           @onchange="e => OnTransportOfferedChanged(StrOf(e), espacosTr)" />
                    <span class="text-muted">de @espacosTr · cada espaço isento não é faturado.</span>
                </div>
            }
            @if (_transportGroups.Count == 0)
            {
                <p class="text-muted mb-0">Sem aves para transporte.</p>
            }
            else
            {
                @for (int gi = 0; gi < _transportGroups.Count; gi++)
                {
                    var gIdx = gi;
                    var g = _transportGroups[gIdx];
                    var (tripLabel, tripCls) = g.Origem switch
                    {
                        "Compra" => ("Bélgica → Portugal", "bg-info-subtle text-info-emphasis border-info-subtle"),
                        "Vende"  => ("Portugal → Bélgica", "bg-warning-subtle text-warning-emphasis border-warning-subtle"),
                        _        => ("", "")
                    };
                    <div class="border rounded p-3 mb-3 bg-body-tertiary">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            <span class="badge bg-primary">Destinatário @(gIdx + 1)</span>
                            <span class="text-muted small">@g.Birds.Count ave@(g.Birds.Count == 1 ? "" : "s")</span>
                            @if (!string.IsNullOrEmpty(tripLabel))
                            {
                                <span class="badge border @tripCls">Viagem: @tripLabel</span>
                            }
                            <button class="btn btn-sm btn-outline-danger ms-auto"
                                    @onclick="() => RemoveTransportGroup(gIdx)">
                                Remover destinatário e todas as aves
                            </button>
                        </div>

                        @{
                            var kOrigem = $"tg_{gIdx}_origem";
                            var kDestNome = $"tg_{gIdx}_destNome";
                            var kDestWa = $"tg_{gIdx}_destWa";
                        }
                        <div class="mb-3" style="max-width:520px">
                            <label class="form-label small text-muted mb-1">Tipo de operação *</label>
                            <select id="fld-@kOrigem" class="form-select form-select-sm @Inv(kOrigem)" value="@g.Origem"
                                    @onchange="e => UpdateTransportGroup(gIdx, x => x with { Origem = StrOf(e) })">
                                <option value="">— selecionar —</option>
                                <option value="Compra">Compra — aves adquiridas pelo criador (Bélgica → Portugal)</option>
                                <option value="Vende">Venda — aves vendidas a terceiros (Portugal → Bélgica)</option>
                            </select>
                            @FldMsg(kOrigem)
                        </div>

                        @if (g.Origem == "Compra" || g.Origem == "Vende")
                        {
                            var isCompra = g.Origem == "Compra";
                            var role = isCompra ? "remetente" : "destinatário";
                            var notasPlaceholder = isCompra
                                ? "Notas adicionais sobre o remetente (ex.: local/hora de recolha, referência do vendedor)"
                                : "Notas adicionais (ex.: instruções de entrega)";
                            if (isCompra)
                            {
                                <div class="alert alert-warning py-2 px-3 small mb-3">
                                    <b>Compra:</b> as aves viajam da Bélgica para Portugal e são entregues ao próprio
                                    criador (<b>@_model.NomeCompleto</b>@(string.IsNullOrWhiteSpace(_model.Telefone) ? "" : $" · {_model.Telefone}")),
                                    junto com as aves de concurso. Indique abaixo os dados do
                                    <b>remetente na Bélgica</b> (quem entrega as aves à convoyage portuguesa).
                                    <div class="mt-1"><b>Importante:</b> o remetente tem de entregar as aves à convoyage portuguesa no <b>domingo de manhã</b>.</div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 px-3 small mb-3">
                                    <b>Venda:</b> as aves viajam de Portugal para a Bélgica e são entregues à pessoa
                                    indicada abaixo, que <b>tem de estar presente na chegada (12h hora belga)</b>.
                                </div>
                            }
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-1">Nome do @role na Bélgica *</label>
                                    <input id="fld-@kDestNome" class="form-control form-control-sm @Inv(kDestNome)" value="@g.DestinatarioNome"
                                           placeholder="Ex: Jan Peeters"
                                           @oninput="e => UpdateTransportGroup(gIdx, x => x with { DestinatarioNome = StrOf(e) })" />
                                    @FldMsg(kDestNome)
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-1">WhatsApp do @role *</label>
                                    <input id="fld-@kDestWa" class="form-control form-control-sm font-monospace @Inv(kDestWa)" value="@g.DestinatarioWhatsapp"
                                           placeholder="+32 470 123 456"
                                           @oninput="e => UpdateTransportGroup(gIdx, x => x with { DestinatarioWhatsapp = StrOf(e) })" />
                                    @FldMsg(kDestWa)
                                </div>
                                <div class="col-12">
                                    <label class="form-label small text-muted mb-1">Notas do @role (opcional)</label>
                                    <textarea class="form-control form-control-sm" rows="2"
                                              placeholder="@notasPlaceholder"
                                              @oninput="e => UpdateTransportGroup(gIdx, x => x with { DestinatarioNotas = StrOf(e) })">@g.DestinatarioNotas</textarea>
                                </div>
                            </div>
                        }

                        <div class="d-flex flex-column gap-2">
                            @for (int bi = 0; bi < g.Birds.Count; bi++)
                            {
                                var bIdx = bi;
                                var b = g.Birds[bIdx];
                                var canRemoveBird = g.Birds.Count > 1;
                                var kBSp = $"tg_{gIdx}_bird{bIdx}_species";
                                var kBAn = $"tg_{gIdx}_bird{bIdx}_anilha";
                                <div class="border rounded p-2 bg-white">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small fw-semibold text-primary">Ave @(bIdx + 1)</span>
                                        @if (canRemoveBird)
                                        {
                                            <button class="btn btn-sm btn-link text-danger p-0"
                                                    @onclick="() => RemoveBirdFromGroup(gIdx, bIdx)">Remover ave</button>
                                        }
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label small text-muted mb-1">Espécie *</label>
                                            <select id="fld-@kBSp" class="form-select form-select-sm @Inv(kBSp)" value="@b.Species"
                                                    @onchange="e => UpdateBirdInGroup(gIdx, bIdx, x => x with { Species = StrOf(e) })">
                                                <option value="">—</option>
                                                @foreach (var sp in SpeciesOptions)
                                                {
                                                    <option value="@sp.Key">@sp.Label</option>
                                                }
                                            </select>
                                            @FldMsg(kBSp)
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small text-muted mb-1">Anilha *</label>
                                            <input id="fld-@kBAn" class="form-control form-control-sm font-monospace @Inv(kBAn)" value="@b.Anilha"
                                                   placeholder="AOB PT STAM 001 FNP26 5.0"
                                                   @oninput="e => UpdateBirdInGroup(gIdx, bIdx, x => x with { Anilha = StrOf(e) })" />
                                            @FldMsg(kBAn)
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <button class="btn btn-sm btn-outline-primary mt-3"
                                @onclick="() => AddBirdToGroup(gIdx)">
                            + Adicionar outra ave @(g.Origem == "Compra" ? "deste remetente" : "para este destinatário")
                        </button>
                    </div>
                }
            }
        </div>
    </div>

    @* ── Resumo de custos ── *@
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-semibold bg-primary text-white">6. Resumo de custos</div>
        <div class="card-body">
            @{ var cs = ComputeCostSummary(); }
            <p class="small text-muted mb-3">
                Valores calculados automaticamente com base nas aves inscritas, aves para venda e aves para transporte.
                O transporte adquirido/cedido é cobrado por <b>espaço</b> (max entre compra e venda).
                @if (cs.VendaOferecidas > 0 || cs.EspacosOferecidos > 0)
                {
                    <span> Oferecidos (isentos) já descontados.</span>
                }
            </p>
            <div class="table-responsive border rounded">
                <table class="table table-sm mb-0 align-middle">
                    <tbody>
                        @if (cs.Fixa > 0)
                        {
                            <tr>
                                <td class="ps-3">Inscrição na exposição</td>
                                <td class="text-end font-monospace pe-3" style="width:140px">@cs.Fixa.ToString("0.00") €</td>
                            </tr>
                        }
                        @if (cs.NConcurso > 0)
                        {
                            <tr>
                                <td class="ps-3">Inscrição por ave · @cs.NConcurso × @ConvoyagePricing.InscricaoPorAve.ToString("0.00") €</td>
                                <td class="text-end font-monospace pe-3">@cs.Inscricoes.ToString("0.00") €</td>
                            </tr>
                        }
                        @if (cs.TotalAvesBruto > 0)
                        {
                            <tr>
                                <td class="ps-3">Aluguer de gaiola · @cs.TotalAvesBruto × @ConvoyagePricing.GaiolaPorAve.ToString("0.00") €</td>
                                <td class="text-end font-monospace pe-3">@cs.GaiolasBruto.ToString("0.00") €</td>
                            </tr>
                            <tr>
                                <td class="ps-3">Transporte @cs.SocioLabel · @cs.TotalAvesBruto × @cs.Tarifa.ToString("0.00") €</td>
                                <td class="text-end font-monospace pe-3">@cs.TransporteBruto.ToString("0.00") €</td>
                            </tr>
                        }
                        @if (cs.EspacosTransporte > 0)
                        {
                            <tr>
                                <td class="ps-3">
                                    Transporte de aves adquiridas/cedidas @cs.SocioLabel · @cs.EspacosTransporte espaço@(cs.EspacosTransporte == 1 ? "" : "s") × @cs.TarifaAdq.ToString("0.00") €
                                    <span class="text-muted small">(max de @cs.NTransporteCompra compra e @cs.NTransporteVende venda)</span>
                                </td>
                                <td class="text-end font-monospace pe-3">@cs.TransporteAdquiridasBruto.ToString("0.00") €</td>
                            </tr>
                        }
                        @if (cs.Quota > 0)
                        {
                            <tr>
                                <td class="ps-3">Quota BVA Portugal</td>
                                <td class="text-end font-monospace pe-3">@cs.Quota.ToString("0.00") €</td>
                            </tr>
                        }
                        @if (cs.VendaOferecidas > 0 || cs.EspacosOferecidos > 0)
                        {
                            <tr class="table-success">
                                <td class="ps-3">
                                    <i class="bi bi-gift"></i>
                                    Oferta (isento de pagamento):
                                    @if (cs.VendaOferecidas > 0)
                                    {
                                        <span>@cs.VendaOferecidas ave@(cs.VendaOferecidas == 1 ? "" : "s") de venda</span>
                                    }
                                    @if (cs.VendaOferecidas > 0 && cs.EspacosOferecidos > 0)
                                    {
                                        <span> + </span>
                                    }
                                    @if (cs.EspacosOferecidos > 0)
                                    {
                                        <span>@cs.EspacosOferecidos espaço@(cs.EspacosOferecidos == 1 ? "" : "s") de transporte</span>
                                    }
                                </td>
                                <td class="text-end font-monospace pe-3 fw-semibold text-success">−@cs.DescontoOferta.ToString("0.00") €</td>
                            </tr>
                        }
                        <tr class="table-primary">
                            <td class="ps-3 fw-semibold">TOTAL a pagar</td>
                            <td class="text-end font-monospace pe-3 fw-semibold fs-5">@cs.Total.ToString("0.00") €</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="alert alert-warning mt-3 mb-0 py-2 px-3 small">
                <b>Pagamento:</b> deve ser feito no valor certo, em dinheiro, num envelope fechado, e entregue juntamente com as aves.
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-5">
        <button class="btn btn-primary" @onclick="() => SaveAsync(resendEmails: false)" disabled="@_saving">
            @(_saving && !_savingWithEmail ? "A guardar..." : "Guardar alterações")
        </button>
        <button class="btn btn-success" @onclick="() => SaveAsync(resendEmails: true)" disabled="@_saving"
                title="Guarda e envia novo email (com PDF e TRACES actualizados) ao criador e à associação.">
            <i class="bi bi-envelope-check"></i>
            @(_savingWithEmail ? "A guardar e enviar..." : "Guardar e reenviar email")
        </button>
        <a class="btn btn-outline-secondary" href="@($"/formularios/{Id}")">Cancelar</a>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _savingWithEmail;
    private bool _saved;
    private string? _error;
    private Dictionary<string, string> _fieldErrors = new();
    // Cache-buster para a imagem da assinatura — muda depois de guardar para
    // forçar refresh se algum dia se permitir substituir a assinatura.
    private long _assinaturaCacheBust = DateTimeOffset.UtcNow.ToUnixTimeSeconds();

    // ── Estado do editor de assinatura ─────────────────────────────────────────
    private bool _signatureEditing;
    private bool _savingSignature;
    private string? _signatureFeedback;
    private bool _signatureFeedbackError;
    private const string SignatureCanvasId = "admin-signature-canvas";

    private async Task StartSignatureEdit()
    {
        _signatureEditing = true;
        _signatureFeedback = null;
        StateHasChanged();
        // Aguarda que o canvas seja renderizado antes de inicializar o pad.
        await Task.Yield();
        await JS.InvokeVoidAsync("SignatureEditor.init", SignatureCanvasId);
    }

    private async Task CancelSignatureEdit()
    {
        _signatureEditing = false;
        _signatureFeedback = null;
        await JS.InvokeVoidAsync("SignatureEditor.destroy", SignatureCanvasId);
    }

    private async Task ClearSignatureCanvas()
    {
        _signatureFeedback = null;
        await JS.InvokeVoidAsync("SignatureEditor.clear", SignatureCanvasId);
    }

    private async Task GenerateSignatureAsync()
    {
        var nome = _model?.NomeCompleto?.Trim();
        if (string.IsNullOrWhiteSpace(nome))
        {
            _signatureFeedback = "Preenche o nome do criador primeiro.";
            _signatureFeedbackError = true;
            return;
        }
        _signatureFeedback = null;
        await JS.InvokeVoidAsync("SignatureEditor.generateFromName", SignatureCanvasId, nome);
    }

    private async Task SaveSignatureAsync()
    {
        _signatureFeedback = null;
        _signatureFeedbackError = false;
        _savingSignature = true;
        try
        {
            var isEmpty = await JS.InvokeAsync<bool>("SignatureEditor.isEmpty", SignatureCanvasId);
            if (isEmpty)
            {
                _signatureFeedback = "Assine antes de guardar.";
                _signatureFeedbackError = true;
                return;
            }
            var dataUrl = await JS.InvokeAsync<string>("SignatureEditor.exportCropped", SignatureCanvasId);
            if (string.IsNullOrWhiteSpace(dataUrl))
            {
                _signatureFeedback = "Assinatura vazia.";
                _signatureFeedbackError = true;
                return;
            }
            var err = await Forms.UpdateConvoyageSignatureAsync(Id, dataUrl);
            if (err is not null)
            {
                _signatureFeedback = err;
                _signatureFeedbackError = true;
                return;
            }
            _signatureFeedback = "Assinatura actualizada.";
            _assinaturaCacheBust = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            // Recarrega o model para pegar o novo AssinaturaPath.
            _model = await Forms.GetConvoyageEditAsync(Id);
            await JS.InvokeVoidAsync("SignatureEditor.destroy", SignatureCanvasId);
            _signatureEditing = false;
        }
        finally
        {
            _savingSignature = false;
        }
    }

    private bool HasErr(string key) => _fieldErrors.ContainsKey(key);
    private string Inv(string key) => _fieldErrors.ContainsKey(key) ? "is-invalid" : "";
    private MarkupString FldMsg(string key)
    {
        if (!_fieldErrors.TryGetValue(key, out var msg)) return default;
        return new MarkupString(
            "<div class=\"invalid-feedback d-block small\">"
            + System.Net.WebUtility.HtmlEncode(msg)
            + "</div>");
    }

    private FormAdminService.ConvoyageEditModel? _model;
    private List<ConvoyageCollectionPoint> _collectionPoints = new();
    private List<FormAdminService.NomGroup> _nomenclature = new();

    private List<IndividualBird> _individuals = new();
    private List<TeamBird> _teams = new();
    private List<SaleBird> _sales = new();
    private List<TransportGroup> _transportGroups = new();
    // Aves oferecidas (isentas de pagamento) — só editável no backoffice; o
    // valor tem de ficar entre 0 e a contagem total da respectiva lista.
    private int _saleOfferedCount;
    private int _transportOfferedCount;

    private static readonly string[] TeamPositions = new[] { "A", "B", "C", "D" };

    private static readonly (string Key, string Label)[] SpeciesOptions = new[]
    {
        ("Roseicollis", "A. roseicollis"),
        ("Personatus",  "A. personatus"),
        ("Fischeri",    "A. fischeri"),
        ("Nigrigenis",  "A. nigrigenis"),
        ("Lilianae",    "A. lilianae"),
        ("Canus",       "A. canus"),
        ("Taranta",     "A. taranta"),
        ("Pullarius",   "A. pullarius"),
        ("Coelestis",   "F. coelestis"),
    };

    protected override async Task OnInitializedAsync()
    {
        _model = await Forms.GetConvoyageEditAsync(Id);
        if (_model is not null)
        {
            var f = await Db.FormSubmissions.AsNoTracking().FirstOrDefaultAsync(x => x.Id == Id);
            if (f?.ConvoyageYearId is int yid)
            {
                _collectionPoints = await Db.ConvoyageCollectionPoints
                    .AsNoTracking()
                    .Where(p => p.ConvoyageYearId == yid)
                    .OrderBy(p => p.SortOrder)
                    .ToListAsync();
                _nomenclature = await Forms.GetNomenclatureForYearAsync(yid);
            }
            HydrateFromModel();
        }
        _loading = false;
    }

    private void HydrateFromModel()
    {
        if (_model is null) return;

        _individuals.Clear();
        _teams.Clear();
        _sales.Clear();
        _transportGroups.Clear();

        var byTeam = _model.Aves
            .Where(a => a.EquipaId.HasValue)
            .GroupBy(a => a.EquipaId!.Value)
            .ToList();

        foreach (var grp in byTeam)
        {
            var first = grp.First();
            var anilhas = new string[4];
            foreach (var m in grp)
            {
                var pos = (m.PosicaoEquipa ?? "").ToUpperInvariant();
                var slot = pos switch { "A" => 0, "B" => 1, "C" => 2, "D" => 3, _ => -1 };
                if (slot >= 0) anilhas[slot] = m.Anilha ?? "";
            }
            for (int i = 0; i < 4; i++) anilhas[i] ??= "";
            _teams.Add(new TeamBird(
                grp.Key,
                NormalizeSpecies(first.Especie),
                first.Serie ?? "",
                first.EspecieMutacao ?? "",
                anilhas));
        }

        foreach (var a in _model.Aves.Where(a => !a.EquipaId.HasValue))
        {
            _individuals.Add(new IndividualBird(
                NormalizeSpecies(a.Especie),
                NormalizeType(a.TipoClasse, defaultToIndividual: true),
                a.Serie ?? "",
                a.EspecieMutacao ?? "",
                a.Anilha ?? ""));
        }

        foreach (var s in _model.AvesVenda)
        {
            _sales.Add(new SaleBird(
                s.EspecieLivre,
                NormalizeSpecies(s.Especie),
                NormalizeType(s.TipoClasse, defaultToIndividual: true),
                "",
                s.EspecieMutacao ?? "",
                s.DataNascimento ?? "",
                string.IsNullOrEmpty(s.Sexo) ? "Indefinido" : s.Sexo,
                s.Preco,
                s.Anilha ?? ""));
        }

        // Agrupa aves por (origem, destinatário) — mantém ordem de chegada.
        var groupsByKey = new Dictionary<(string, string, string, string), TransportGroup>();
        var groupOrder = new List<(string, string, string, string)>();
        foreach (var t in _model.AvesTransporte)
        {
            var origem = t.Origem switch
            {
                "Compra"    => "Compra",
                "Vende"     => "Vende",
                "Adquirida" => "Compra", // legado
                "Cedida"    => "Vende",  // legado
                _           => "Compra",
            };
            var destNome  = t.DestinatarioNome ?? "";
            var destWa    = t.DestinatarioWhatsapp ?? "";
            var destNotas = t.DestinatarioNotas ?? "";
            var key = (origem, destNome, destWa, destNotas);
            if (!groupsByKey.TryGetValue(key, out var grp))
            {
                grp = new TransportGroup(origem, destNome, destWa, destNotas, new List<TransportGroupBird>());
                groupsByKey[key] = grp;
                groupOrder.Add(key);
            }
            grp.Birds.Add(new TransportGroupBird(NormalizeSpecies(t.Especie), t.Anilha ?? ""));
        }
        foreach (var k in groupOrder) _transportGroups.Add(groupsByKey[k]);

        _saleOfferedCount = Math.Clamp(_model.NumAvesVendaOferecidas, 0, _sales.Count);
        var maxEspacos = ConvoyagePricing.EspacosTransporteAdquirido(
            _transportGroups.Where(g => g.Origem == "Compra").Sum(g => g.Birds.Count),
            _transportGroups.Where(g => g.Origem == "Vende").Sum(g => g.Birds.Count));
        _transportOfferedCount = Math.Clamp(_model.NumAvesTransporteOferecidas, 0, maxEspacos);
    }

    // ── Species / Nomenclature helpers ────────────────────────────────────────

    private record MutationGroupView(string DisplayName, List<FormAdminService.NomClass> Classes, string EntryType);

    private List<MutationGroupView> MutationsForConcurso(string species)
    {
        if (string.IsNullOrEmpty(species)) return new();
        return _nomenclature
            .Where(g => g.Species == species && (g.EntryType == "Individual" || g.EntryType == "Study"))
            .Select(g => new MutationGroupView(g.DisplayName, g.Classes, g.EntryType))
            .ToList();
    }

    private List<MutationGroupView> MutationsForTeam(string species)
    {
        if (string.IsNullOrEmpty(species)) return new();
        return _nomenclature
            .Where(g => g.Species == species && g.EntryType == "Team")
            .Select(g => new MutationGroupView(g.DisplayName, g.Classes, g.EntryType))
            .ToList();
    }

    private List<MutationGroupView> MutationsForSale(string species)
    {
        if (string.IsNullOrEmpty(species)) return new();
        return _nomenclature
            .Where(g => g.Species == species)
            .Select(g => new MutationGroupView(g.DisplayName, g.Classes, g.EntryType))
            .ToList();
    }

    private static List<NomenclatureCombobox.GroupView> ComboGroups(List<MutationGroupView> groups) =>
        groups.Select(g => new NomenclatureCombobox.GroupView(
            g.DisplayName,
            g.Classes.Select(c => new NomenclatureCombobox.ItemView(c.Code, c.Mutation, g.EntryType)).ToList()
        )).ToList();

    private static string DisplayFor(string serie, string mutation) =>
        string.IsNullOrEmpty(serie) && string.IsNullOrEmpty(mutation)
            ? ""
            : $"{serie} — {mutation}";

    private static string NormalizeSpecies(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        var t = s.Trim();
        if (t.StartsWith("agapornis_", StringComparison.OrdinalIgnoreCase))
            t = t["agapornis_".Length..];
        if (t.Length == 0) return "";
        t = char.ToUpperInvariant(t[0]) + t[1..].ToLowerInvariant();
        return t;
    }

    private static string NormalizeType(string? t, bool defaultToIndividual)
    {
        if (string.IsNullOrWhiteSpace(t)) return defaultToIndividual ? "Individual" : "";
        var s = t.Trim();
        if (s.Equals("Individual", StringComparison.OrdinalIgnoreCase)) return "Individual";
        if (s.Equals("Team", StringComparison.OrdinalIgnoreCase)) return "Team";
        if (s.Equals("Study", StringComparison.OrdinalIgnoreCase)) return "Study";
        if (s.Equals("show", StringComparison.OrdinalIgnoreCase)) return "Individual";
        return defaultToIndividual ? "Individual" : "";
    }

