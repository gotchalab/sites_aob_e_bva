    // ── Save ─────────────────────────────────────────────────────────────────

    private void ValidateFields()
    {
        _fieldErrors.Clear();
        if (_model is null) return;

        if (string.IsNullOrWhiteSpace(_model.NomeCompleto)) _fieldErrors["nomeCompleto"] = "Nome completo obrigatório.";
        if (string.IsNullOrWhiteSpace(_model.Email))        _fieldErrors["email"]        = "Email obrigatório.";
        if (string.IsNullOrWhiteSpace(_model.Pais))         _fieldErrors["pais"]         = "País obrigatório.";
        if (string.IsNullOrWhiteSpace(_model.NumeroStam))   _fieldErrors["numeroStam"]   = "Nº STAM obrigatório.";

        for (int i = 0; i < _individuals.Count; i++)
        {
            var b = _individuals[i];
            if (string.IsNullOrEmpty(b.Species))
                _fieldErrors[$"ind_{i}_species"] = "Espécie obrigatória.";
            if (string.IsNullOrEmpty(b.Serie) || string.IsNullOrEmpty(b.Mutation))
                _fieldErrors[$"ind_{i}_selection"] = "Selecione a série/mutação.";
            if (string.IsNullOrWhiteSpace(b.Anilha))
                _fieldErrors[$"ind_{i}_anilha"] = "Anilha obrigatória.";
        }

        for (int i = 0; i < _teams.Count; i++)
        {
            var t = _teams[i];
            if (string.IsNullOrEmpty(t.Species))
                _fieldErrors[$"team_{i}_species"] = "Espécie obrigatória.";
            if (string.IsNullOrEmpty(t.Serie) || string.IsNullOrEmpty(t.Mutation))
                _fieldErrors[$"team_{i}_selection"] = "Selecione a série/mutação.";
            for (int j = 0; j < 4; j++)
            {
                if (string.IsNullOrWhiteSpace(t.Anilhas[j]))
                    _fieldErrors[$"team_{i}_anilha{j}"] = $"Anilha {TeamPositions[j]} obrigatória.";
            }
        }

        for (int i = 0; i < _sales.Count; i++)
        {
            var s = _sales[i];
            if (string.IsNullOrEmpty(s.Species))
                _fieldErrors[$"sale_{i}_species"] = "Espécie obrigatória.";
            if (string.IsNullOrWhiteSpace(s.Mutation))
                _fieldErrors[$"sale_{i}_selection"] = s.FreeSpecies ? "Descreva a mutação." : "Selecione a mutação.";
            if (s.Preco < 0)
                _fieldErrors[$"sale_{i}_preco"] = "Preço inválido.";
            if (string.IsNullOrWhiteSpace(s.Anilha))
                _fieldErrors[$"sale_{i}_anilha"] = "Anilha obrigatória.";
        }

        for (int gi = 0; gi < _transportGroups.Count; gi++)
        {
            var g = _transportGroups[gi];
            if (string.IsNullOrWhiteSpace(g.Origem))
                _fieldErrors[$"tg_{gi}_origem"] = "Selecione se é Compra ou Venda.";
            if (g.Origem == "Compra" || g.Origem == "Vende")
            {
                var role = g.Origem == "Compra" ? "remetente" : "destinatário";
                if (string.IsNullOrWhiteSpace(g.DestinatarioNome))
                    _fieldErrors[$"tg_{gi}_destNome"] = $"Nome do {role} obrigatório.";
                if (string.IsNullOrWhiteSpace(g.DestinatarioWhatsapp))
                    _fieldErrors[$"tg_{gi}_destWa"] = $"WhatsApp do {role} obrigatório.";
            }
            for (int bi = 0; bi < g.Birds.Count; bi++)
            {
                var b = g.Birds[bi];
                if (string.IsNullOrEmpty(b.Species))
                    _fieldErrors[$"tg_{gi}_bird{bi}_species"] = "Espécie obrigatória.";
                if (string.IsNullOrWhiteSpace(b.Anilha))
                    _fieldErrors[$"tg_{gi}_bird{bi}_anilha"] = "Anilha obrigatória.";
            }
        }
    }

    private async Task SaveAsync(bool resendEmails)
    {
        if (_model is null) return;
        _error = null;
        _saved = false;

        ValidateFields();
        if (_fieldErrors.Count > 0)
        {
            StateHasChanged();
            await Task.Yield();
            await JS.InvokeVoidAsync("aobFormHelpers.scrollToFirstInvalid");
            return;
        }

        _saving = true;
        _savingWithEmail = resendEmails;
        try
        {
            var aves = new List<FormAdminService.ConvoyageAveEdit>();

            foreach (var b in _individuals)
            {
                aves.Add(new FormAdminService.ConvoyageAveEdit(
                    b.Serie, b.Species,
                    string.IsNullOrEmpty(b.TipoClasse) ? "Individual" : b.TipoClasse,
                    b.Mutation, b.Anilha, null, null));
            }

            foreach (var t in _teams)
            {
                for (int j = 0; j < 4; j++)
                {
                    aves.Add(new FormAdminService.ConvoyageAveEdit(
                        t.Serie, t.Species, "Team",
                        t.Mutation, t.Anilhas[j], t.EquipaId, TeamPositions[j]));
                }
            }

            var avesVenda = _sales.Select(s => new FormAdminService.ConvoyageAveVendaEdit(
                s.Species,
                string.IsNullOrEmpty(s.TipoClasse) ? null : s.TipoClasse,
                s.Mutation,
                s.FreeSpecies,
                string.IsNullOrWhiteSpace(s.DataNascimento) ? null : s.DataNascimento,
                s.Sexo,
                s.Preco,
                s.Anilha
            )).ToList();

            // Compra: dados do remetente na Bélgica (quem entrega as aves à convoyage portuguesa).
            // Vende: dados do destinatário na Bélgica (quem recebe as aves).
            var avesTransporte = _transportGroups.SelectMany(g =>
            {
                var origem = string.IsNullOrWhiteSpace(g.Origem) ? "Compra" : g.Origem;
                var destNotas = string.IsNullOrWhiteSpace(g.DestinatarioNotas) ? null : g.DestinatarioNotas;
                return g.Birds.Select(b => new FormAdminService.ConvoyageAveTransporteEdit(
                    b.Species, origem, b.Anilha, g.DestinatarioNome, g.DestinatarioWhatsapp, destNotas));
            }).ToList();

            // Clamp defensivo caso o input tenha desalinhado (ex.: valor manual > total actual).
            var saleOffered = Math.Clamp(_saleOfferedCount, 0, avesVenda.Count);
            var maxEspacos = ConvoyagePricing.EspacosTransporteAdquirido(
                avesTransporte.Count(a => a.Origem is "Compra" or "Adquirida"),
                avesTransporte.Count(a => a.Origem is "Vende" or "Cedida"));
            var transportOffered = Math.Clamp(_transportOfferedCount, 0, maxEspacos);
            var payload = _model with
            {
                Aves = aves,
                AvesVenda = avesVenda,
                AvesTransporte = avesTransporte,
                NumAvesVendaOferecidas = saleOffered,
                NumAvesTransporteOferecidas = transportOffered,
            };
            _error = await Forms.UpdateConvoyageAsync(Id, payload, resendEmails);
            if (_error is null)
            {
                Nav.NavigateTo("/convoyage/inscricoes");
                return;
            }
        }
        finally
        {
            _saving = false;
            _savingWithEmail = false;
        }
    }

