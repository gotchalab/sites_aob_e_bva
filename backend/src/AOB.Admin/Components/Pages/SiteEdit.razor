@page "/sites/{Id:int}"
@attribute [Authorize]
@inject SiteAdminService SiteAdmin
@inject UploadService Uploads
@inject RevalidateNotifier Revalidate
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>@(Model?.Name ?? "Site") · Homepage</PageTitle>

@if (Model is null || Home is null || Ann is null)
{
    <p class="text-muted">A carregar...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <a href="/sites" class="text-decoration-none small">← Sites</a>
            <h1 class="h3 mb-0">Homepage — @Model.Name</h1>
            <div class="text-muted small">@Model.Domain</div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="alert alert-success">@Message</div>
    }
    @if (!string.IsNullOrEmpty(ErrorMsg))
    {
        <div class="alert alert-danger">@ErrorMsg</div>
    }

    <EditForm Model="Model" OnValidSubmit="OnSave" FormName="SiteForm">
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5">Hero</h2>
                        <div class="mb-3">
                            <label class="form-label">Tagline (frase curta sob o título)</label>
                            <input class="form-control" @bind="Model.Tagline" maxlength="300" placeholder="Ex.: A associação dos ornitólogos de Barcelos desde 1985" />
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5">Missão</h2>
                        <div class="mb-3">
                            <label class="form-label">Título da secção (h2)</label>
                            <input class="form-control" @bind="Home.MissionTitle" maxlength="100" placeholder="Ex.: A tua referência para criar aves com confiança em Barcelos." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Texto (2 parágrafos curtos)</label>
                            <textarea class="form-control" rows="5" @bind="Home.Mission"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Citação lateral</label>
                            <textarea class="form-control" rows="3" @bind="Home.MissionQuote" maxlength="300" placeholder="Frase de destaque que aparece ao lado do texto de missão."></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Imagem (URL ou upload)</label>
                            @if (!string.IsNullOrEmpty(Home.MissionImageUrl))
                            {
                                <div class="bg-light p-2 rounded mb-2">
                                    <img src="@Home.MissionImageUrl" alt="" style="max-height: 140px;" />
                                </div>
                            }
                            <InputFile OnChange="OnUploadMissionImage" accept="image/*" class="form-control form-control-sm mb-1" />
                            <input class="form-control form-control-sm" @bind="Home.MissionImageUrl" placeholder="ou URL" />
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center mb-2">
                        <h2 class="h5 mb-0">Áreas de atuação</h2>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddArea">+ Nova área</button>
                    </div>
                    <div class="card-body pt-0">
                        @if (Home.Areas.Count == 0)
                        {
                            <p class="text-muted small">Sem áreas configuradas. A secção não aparece na homepage.</p>
                        }
                        else
                        {
                            @for (int i = 0; i < Home.Areas.Count; i++)
                            {
                                var idx = i;
                                var area = Home.Areas[i];
                                <div class="border rounded p-3 mb-2">
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label small">Ícone</label>
                                            <IconPicker @bind-Value="area.Icon" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Título</label>
                                            <input class="form-control form-control-sm" @bind="area.Title" maxlength="30" />
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label small">Link (rota)</label>
                                            <input class="form-control form-control-sm font-monospace" @bind="area.Href" placeholder="/exemplo" />
                                        </div>
                                        <div class="col-md-1 d-flex align-items-end">
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveArea(idx)">×</button>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small">Descrição</label>
                                            <textarea class="form-control form-control-sm" rows="2" maxlength="120" @bind="area.Description"></textarea>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body d-flex justify-content-between align-items-center mb-2">
                        <h2 class="h5 mb-0">Benefícios de ser sócio</h2>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddBenefit">+ Novo benefício</button>
                    </div>
                    <div class="card-body pt-0">
                        @if (Home.Benefits.Count == 0)
                        {
                            <p class="text-muted small">Sem benefícios configurados — são usados os valores predefinidos do código.</p>
                        }
                        else
                        {
                            @for (int i = 0; i < Home.Benefits.Count; i++)
                            {
                                var idx = i;
                                var benefit = Home.Benefits[i];
                                <div class="border rounded p-3 mb-2">
                                    <div class="row g-2">
                                        <div class="col-md-3">
                                            <label class="form-label small">Ícone</label>
                                            <IconPicker @bind-Value="benefit.Icon" />
                                        </div>
                                        <div class="col-md-8">
                                            <label class="form-label small">Label</label>
                                            <input class="form-control form-control-sm" @bind="benefit.Label" maxlength="40" />
                                        </div>
                                        <div class="col-md-1 d-flex align-items-end">
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveBenefit(idx)">×</button>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small">Descrição</label>
                                            <textarea class="form-control form-control-sm" rows="2" maxlength="160" @bind="benefit.Description"></textarea>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h5">CTA "Torna-te sócio"</h2>
                        <div class="row g-2">
                            <div class="col-md-6">
                                <label class="form-label small">Título</label>
                                <input class="form-control form-control-sm" @bind="Home.CtaTitle" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small">Texto do botão</label>
                                <input class="form-control form-control-sm" @bind="Home.CtaLabel" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small">Subtítulo</label>
                                <input class="form-control form-control-sm" @bind="Home.CtaSubtitle" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small">Link do botão</label>
                                <input class="form-control form-control-sm font-monospace" @bind="Home.CtaHref" placeholder="/inscricao-socio" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h6">Estatísticas</h2>
                        <p class="text-muted small">Deixar vazio esconde a card na homepage.</p>
                        <div class="mb-2">
                            <label class="form-label small">Fundada em</label>
                            <input class="form-control form-control-sm" type="number" min="1900" max="2100" @bind="Home.FoundedYear" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Sócios ativos</label>
                            <input class="form-control form-control-sm" type="number" min="0" @bind="Home.MemberCount" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Anilhas por ano</label>
                            <input class="form-control form-control-sm" type="number" min="0" @bind="Home.RingsPerYear" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Espécies</label>
                            <input class="form-control form-control-sm" type="number" min="0" @bind="Home.SpeciesCount" />
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h6">Banda de aviso (topo)</h2>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="annEn" @bind="Ann.Enabled" />
                            <label class="form-check-label" for="annEn">Ativa</label>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Mensagem</label>
                            <input class="form-control form-control-sm" @bind="Ann.Message" maxlength="200" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Link (opcional)</label>
                            <input class="form-control form-control-sm font-monospace" @bind="Ann.Href" placeholder="/exemplo" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small">Tom</label>
                            <select class="form-select form-select-sm" @bind="Ann.Tone">
                                @foreach (var t in AnnouncementModel.AllowedTones)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Guardar e revalidar</button>
                    <a href="/sites" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private Site? Model;
    private HomeConfigModel? Home;
    private AnnouncementModel? Ann;
    private string? Message;
    private string? ErrorMsg;

    protected override async Task OnInitializedAsync()
    {
        Model = await SiteAdmin.GetAsync(Id);
        if (Model is null)
        {
            Nav.NavigateTo("/sites");
            return;
        }
        Home = HomeConfigModel.FromJson(Model.HomeConfig);
        Ann = AnnouncementModel.FromJson(Model.Announcement);
    }

    private void AddArea()
    {
        Home?.Areas.Add(new HomeConfigModel.AreaItem { Icon = "Award" });
    }

    private void RemoveArea(int idx)
    {
        if (Home is null) return;
        if (idx >= 0 && idx < Home.Areas.Count) Home.Areas.RemoveAt(idx);
    }

    private void AddBenefit()
    {
        Home?.Benefits.Add(new HomeConfigModel.BenefitItem { Icon = "Award" });
    }

    private void RemoveBenefit(int idx)
    {
        if (Home is null) return;
        if (idx >= 0 && idx < Home.Benefits.Count) Home.Benefits.RemoveAt(idx);
    }

    private async Task OnSave()
    {
        if (Model is null || Home is null || Ann is null) return;
        try
        {
            Model.HomeConfig = Home.ToJson();
            if (Ann.Enabled && string.IsNullOrWhiteSpace(Ann.Message))
            {
                Ann.Enabled = false;
            }
            Model.Announcement = Ann.ToJson();
            await SiteAdmin.SaveAsync(Model);
            Message = "Guardado.";
            ErrorMsg = null;
            _ = Revalidate.NotifyAsync(Model.Slug, "/");
        }
        catch (Exception ex)
        {
            ErrorMsg = ex.Message;
        }
    }

    private async Task OnUploadMissionImage(InputFileChangeEventArgs e)
    {
        if (Model is null || Home is null) return;
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var res = await Uploads.SaveAsync(stream, e.File.Name, Model.Slug, "home");
            Home.MissionImageUrl = res.PublicPath;
            Message = "Imagem carregada.";
            ErrorMsg = null;
        }
        catch (Exception ex)
        {
            ErrorMsg = ex.Message;
        }
    }
}
