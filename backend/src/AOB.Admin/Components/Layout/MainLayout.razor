@inherits LayoutComponentBase

<div class="admin-page">
    <input type="checkbox" id="admin-sidebar-toggle" class="admin-sidebar-checkbox" />
    <aside class="admin-sidebar bg-dark text-white">
        <NavMenu />
    </aside>
    <label for="admin-sidebar-toggle" class="admin-backdrop" aria-hidden="true"></label>
    <main class="admin-main">
        <header class="admin-topbar border-bottom bg-white d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2 min-w-0">
                <label for="admin-sidebar-toggle"
                       class="btn btn-sm btn-outline-secondary admin-sidebar-toggle-btn mb-0"
                       aria-label="Abrir menu"
                       role="button">
                    <i class="bi bi-list"></i>
                </label>
                <div class="text-muted small text-truncate">Backoffice AOB</div>
            </div>
            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/auth/logout" class="d-inline d-flex align-items-center gap-2 min-w-0 mb-0">
                        <span class="small text-truncate admin-user-name">@context.User.Identity?.Name</span>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Sair</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </header>
        <div class="admin-content">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro. <a href="." class="reload">Recarregar</a>
    <span class="dismiss">×</span>
</div>
