@inherits LayoutComponentBase

<div class="admin-page d-flex">
    <aside class="admin-sidebar bg-dark text-white flex-shrink-0" style="width: 240px; min-height: 100vh;">
        <NavMenu />
    </aside>
    <main class="flex-grow-1" style="min-width: 0;">
        <header class="admin-topbar border-bottom bg-white px-4 py-2 d-flex justify-content-between align-items-center">
            <div class="text-muted small">Backoffice AOB</div>
            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/auth/logout" class="d-inline">
                        <span class="me-3 small">@context.User.Identity?.Name</span>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Sair</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </header>
        <div class="p-4">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocorreu um erro. <a href="." class="reload">Recarregar</a>
    <span class="dismiss">×</span>
</div>
